---
import Layout from '../layouts/Layout.astro';
import promotions from '../data/promotions.json';
import bikes from '../data/bikes.json';
import site from '../data/site.json';

const combo = promotions.combo;
const eligibleBikes = bikes.filter((b) => b.comboEligible);
---

<Layout
  title="Combo Motero Todo Incluido 2026 | Nexus Motos Perú - Grupo Lauzher"
  description="Llévate tu moto Nexus 0 km con Casco Certificado DOT, trámite de Placa y Tarjeta ante SUNARP y 3 mantenimientos gratis incluidos."
>
  <!-- Header in Clean Light Gray -->
  <section class="bg-gray-50 py-20 px-6 border-b border-gray-200 relative overflow-hidden">
    <div class="max-w-7xl mx-auto text-center relative z-10">
      <span class="inline-block px-4 py-1 rounded-full bg-emerald-100 border border-emerald-200 text-emerald-800 text-xs font-black uppercase tracking-widest font-['Teko',sans-serif] mb-3">
        {combo.badge}
      </span>
      <h1 class="text-5xl md:text-7xl lg:text-8xl font-black uppercase text-gray-900 font-['Teko',sans-serif] tracking-tight leading-none">
        BENEFICIOS POR TU COMPRA
      </h1>
      <p class="text-lg md:text-xl font-bold uppercase text-gray-800 tracking-wide mt-2">
        Estimado Cliente, por la compra de su unidad, se le incluyen estos beneficios:
      </p>
      <div class="mt-4 flex flex-wrap items-center justify-center gap-3">
        <span class="inline-block bg-emerald-100 border border-emerald-300 text-emerald-900 font-bold px-4 py-2 rounded-xl text-xs md:text-sm shadow-sm">
          🏅 Garantía por 1 año o 12,000KM, lo que suceda primero (Sólo Motor)
        </span>
        <span class="inline-block bg-blue-100 border border-blue-300 text-blue-900 font-bold px-4 py-2 rounded-xl text-xs md:text-sm shadow-sm">
          📍 Tarjeta y Placa (Demora máx. 15 a 20 días hábiles)
        </span>
      </div>
    </div>
  </section>

  <!-- What's included in Pure White -->
  <section class="py-16 px-6 bg-white text-gray-900">
    <div class="max-w-5xl mx-auto space-y-12">
      <div class="text-center">
        <h2 class="text-3xl md:text-5xl font-black uppercase text-gray-900 font-['Teko',sans-serif] tracking-tight">
          PAQUETE OFICIAL DE ENTREGA
        </h2>
        <p class="text-gray-600 text-sm mt-1">
          Sin costos ocultos ni sorpresas. Todo lo que recibes con tu nueva moto:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {combo.items.map((item, idx) => (
          <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6 flex items-start gap-4 hover:border-emerald-300 transition-colors shadow-sm">
            <div class="w-12 h-12 rounded-xl bg-emerald-100 text-emerald-800 flex items-center justify-center font-bold text-lg flex-shrink-0 font-['Teko',sans-serif] text-2xl">
              0{idx + 1}
            </div>
            <div class="space-y-1 flex-1">
              <div class="flex items-center justify-between">
                <h3 class="text-lg font-bold text-gray-900 uppercase font-['Teko',sans-serif] tracking-wide">
                  {item.name}
                </h3>
                <span class="text-[10px] font-black uppercase px-2 py-0.5 rounded bg-emerald-100 text-emerald-900 border border-emerald-300">
                  {item.value}
                </span>
              </div>
              <p class="text-xs text-gray-600 leading-relaxed">
                {item.description}
              </p>
            </div>
          </div>
        ))}
      </div>

      <!-- Official Client Guarantee Banner -->
      <div class="bg-amber-50 border border-amber-200 rounded-2xl p-6 text-sm text-gray-800 space-y-4 shadow-sm">
        <h4 class="font-bold text-gray-900 uppercase font-['Teko',sans-serif] text-2xl tracking-wide">
          Condiciones Oficiales de Entrega y Garantía:
        </h4>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs md:text-sm">
          <div class="bg-white p-4 rounded-xl border border-amber-200/80 shadow-sm space-y-1">
            <span class="font-bold text-gray-900 flex items-center gap-1.5 text-sm">
              📍 Trámite Registral SUNARP
            </span>
            <p class="text-gray-600 leading-relaxed">
              Asimismo, el trámite de tarjeta y placa tiene una demora máximo de 15 a 20 días hábiles.
            </p>
          </div>
          <div class="bg-white p-4 rounded-xl border border-amber-200/80 shadow-sm space-y-1">
            <span class="font-bold text-gray-900 flex items-center gap-1.5 text-sm">
              🏅 Garantía Oficial
            </span>
            <p class="text-gray-600 leading-relaxed">
              Garantía por 1 año o 12,000KM, lo que suceda primero. (Sólo Motor).
            </p>
          </div>
        </div>
        <p class="text-xs text-amber-950 font-semibold bg-amber-100/70 p-3 rounded-lg border border-amber-200">
          🛠️ Recuerda que los 03 primeros Mantenimientos son GRATIS (mano de obra) 😉 en toda la red de talleres autorizados de Grupo Lauzher.
        </p>
      </div>
    </div>
  </section>

  <!-- Eligible Models in Clean Light Gray -->
  <section class="py-16 px-6 bg-gray-50 border-t border-gray-200">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-4xl md:text-6xl font-black uppercase text-gray-900 font-['Teko',sans-serif] tracking-tight">
          ELIGE TU MOTO PARA APLICAR EL COMBO
        </h2>
        <p class="text-gray-600 text-sm">
          Aplica tanto para compras al contado como financiamiento en cuotas mensuales.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {eligibleBikes.map((bike) => (
          <div class="bg-white border border-gray-200 rounded-2xl p-6 flex flex-col justify-between group hover:border-gray-300 transition-all shadow-sm hover:shadow-lg">
            <div class="relative h-48 flex items-center justify-center p-2 mb-4 bg-gray-200 rounded-xl overflow-hidden">
              <img
                src={`/images/categories/bg-${bike.category}.jpg`}
                alt=""
                aria-hidden="true"
                class="absolute inset-0 w-full h-full object-cover object-center opacity-80 brightness-110 transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-[radial-gradient(ellipse_75%_70%_at_50%_55%,rgba(255,255,255,0.92)_0%,rgba(255,255,255,0.72)_45%,rgba(255,255,255,0.22)_80%,transparent_100%)] pointer-events-none"></div>
              <div class="absolute bottom-3 left-1/2 -translate-x-1/2 w-2/3 h-3 bg-black/30 blur-md rounded-full pointer-events-none"></div>
              <img
                src={bike.transparentImage}
                alt={bike.name}
                class="relative z-10 max-h-40 w-auto object-contain transition-transform duration-500 group-hover:scale-108 [filter:drop-shadow(0_0_8px_rgba(255,255,255,0.95))_drop-shadow(0_10px_12px_rgba(0,0,0,0.35))]"
                loading="lazy"
              />
            </div>

            <div class="space-y-3">
              <div>
                <span class="text-[10px] font-bold text-gray-500 uppercase tracking-wider">{bike.categoryLabel}</span>
                <h3 class="text-2xl font-black uppercase text-gray-900 font-['Teko',sans-serif]">{bike.name}</h3>
                <span class="text-sm font-semibold text-gray-500">{bike.cc}</span>
              </div>

              <div class="pt-3 border-t border-gray-200 flex items-center justify-between">
                <div>
                  <span class="text-[10px] text-gray-500 uppercase block font-semibold">Precio Moto</span>
                  <span class="text-2xl font-black text-gray-900 font-['Teko',sans-serif]">{bike.priceFromPen}</span>
                </div>
                <a
                  href={`https://wa.me/${site.whatsappNumber}?text=Hola%20Grupo%20Lauzher,%20deseo%20separar%20el%20Combo%20Motero%20con%20la%20${encodeURIComponent(bike.name)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="px-4 py-2 rounded-full text-xs font-black uppercase tracking-wider text-white bg-emerald-600 hover:bg-emerald-700 shadow-sm transition-all flex items-center gap-1.5"
                >
                  Separar Combo
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
