---
import Layout from '../../layouts/Layout.astro';
import bikes from '../../data/bikes.json';

const categories = [
  { id: 'todas', label: 'Todos los Modelos', count: bikes.length },
  { id: 'pisteras', label: 'Pisteras', count: bikes.filter((b) => b.category === 'pisteras').length },
  { id: 'deportivas', label: 'Deportivas', count: bikes.filter((b) => b.category === 'deportivas').length },
  { id: 'scooter', label: 'Scooters', count: bikes.filter((b) => b.category === 'scooter').length },
  { id: 'todoterreno', label: 'Todoterreno', count: bikes.filter((b) => b.category === 'todoterreno').length },
  { id: 'caferacer', label: 'Cafe Racer', count: bikes.filter((b) => b.category === 'caferacer').length }
];
---

<Layout
  title="Catálogo Completo de Modelos Nexus Motos | Grupo Lauzher"
  description="Explora todos los modelos oficiales de Nexus Motos en Perú: Pisteras, Deportivas, Scooters, Todoterreno y Cafe Racer con respaldo oficial de Grupo Lauzher."
>
  <!-- Header in Clean Light Gray / White -->
  <section class="bg-gray-50 pt-12 pb-6 px-6 border-b border-gray-200">
    <div class="max-w-7xl mx-auto text-center">
      <span class="text-xs font-bold text-[#FF0000] uppercase tracking-widest font-['Teko',sans-serif] text-base">
        LINEUP OFICIAL
      </span>
      <h1 class="text-5xl md:text-7xl font-black uppercase text-gray-900 font-['Teko',sans-serif] tracking-tight mt-1">
        CATÁLOGO DE MOTOS <span class="text-[#FF0000]">NEXUS</span>
      </h1>
      <p class="text-gray-600 text-sm md:text-base max-w-2xl mx-auto mt-2 font-medium">
        Encuentra la moto perfecta para tu estilo de vida o tu negocio, con el respaldo y garantía de Grupo Lauzher en todo el Perú.
      </p>

      <!-- Category Filter Buttons with Direct Model Counts -->
      <div class="mt-6 flex items-center justify-center gap-2 flex-wrap" id="catalog-category-tabs">
        {categories.map((cat, i) => (
          <button
            class={`catalog-cat-btn inline-flex items-center gap-2 px-4 py-2 md:px-5 md:py-2.5 rounded-full text-xs md:text-sm font-bold uppercase tracking-wider border transition-all cursor-pointer ${
              i === 0
                ? 'bg-[#FF0000] text-white border-[#FF0000] shadow-md active-cat'
                : 'bg-white text-gray-700 hover:bg-gray-100 hover:text-black border-gray-300'
            }`}
            data-category={cat.id}
          >
            <span>{cat.label}</span>
            <span class={`cat-badge text-[11px] font-black px-2 py-0.5 rounded-full transition-colors ${
              i === 0 ? 'bg-black/20 text-white' : 'bg-gray-100 text-gray-700'
            }`}>
              {cat.count}
            </span>
          </button>
        ))}
      </div>

      <!-- Cilindrada Filters (Compact, Centered, Clean) -->
      <div class="mt-4 flex items-center justify-center gap-2 flex-wrap">
        <span class="text-xs font-bold uppercase text-gray-500 mr-0.5">Cilindrada:</span>
        <div class="inline-flex items-center gap-1.5 flex-wrap justify-center">
          {['all', '125', '150', '200', '250'].map((ccVal, idx) => (
            <button
              class={`catalog-cc-btn px-3 py-1 rounded-full text-xs font-bold uppercase border transition-all cursor-pointer ${
                idx === 0
                  ? 'bg-gray-900 text-white border-gray-900'
                  : 'bg-white text-gray-600 hover:bg-gray-100 border-gray-300'
              }`}
              data-cc={ccVal}
            >
              {ccVal === 'all' ? 'Todas' : `${ccVal} cc`}
            </button>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Product Grid in Clean White -->
  <section class="pt-8 pb-16 px-6 bg-white min-h-[600px]">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="catalog-grid">
        {bikes.map((bike, index) => (
          <div
            class="catalog-bike-card bg-gray-50 hover:bg-white border border-gray-200 hover:border-gray-300 rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group"
            data-category={bike.category}
            data-cc={parseInt(bike.cc.replace('cc', '').trim())}
            data-price={bike.rawPricePen}
            data-original-index={index}
          >
            <!-- Visual Container -->
            <div class="relative bg-gray-200 h-64 p-6 flex items-center justify-center overflow-hidden">
              <img
                src={`/images/categories/bg-${bike.category}.jpg`}
                alt=""
                aria-hidden="true"
                class="absolute inset-0 w-full h-full object-cover object-center opacity-80 brightness-110 transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
              />
              <!-- Bright central spotlight so dark/red bikes never blend into the background -->
              <div class="absolute inset-0 bg-[radial-gradient(ellipse_75%_70%_at_50%_55%,rgba(255,255,255,0.92)_0%,rgba(255,255,255,0.72)_45%,rgba(255,255,255,0.22)_80%,transparent_100%)] pointer-events-none"></div>
              <!-- Ground shadow under wheels -->
              <div class="absolute bottom-5 left-1/2 -translate-x-1/2 w-2/3 h-3.5 bg-black/30 blur-md rounded-full pointer-events-none"></div>

              <img
                src={bike.transparentImage}
                alt={bike.name}
                class="relative z-10 max-h-52 w-auto object-contain transition-transform duration-500 group-hover:scale-108 [filter:drop-shadow(0_0_8px_rgba(255,255,255,0.95))_drop-shadow(0_10px_12px_rgba(0,0,0,0.35))]"
                loading="lazy"
              />
            </div>

            <!-- Card Info -->
            <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
              <div>
                <span class="text-[11px] uppercase font-bold text-[#FF0000] tracking-wider">
                  {bike.categoryLabel}
                </span>
                <h2 class="text-2xl font-black uppercase text-gray-900 font-['Teko',sans-serif] tracking-wide mt-0.5 group-hover:text-[#FF0000] transition-colors">
                  {bike.name}
                </h2>
                <p class="text-xs text-gray-600 line-clamp-2 mt-1 leading-relaxed">
                  {bike.description}
                </p>
              </div>

              <!-- Mini specs -->
              <div class="grid grid-cols-3 gap-2 py-3 border-y border-gray-200 text-center">
                <div class="bg-white border border-gray-200/90 rounded-lg p-2">
                  <span class="text-[9px] uppercase font-bold text-gray-500 block">Motor</span>
                  <span class="text-xs font-bold text-gray-900">{bike.cc}</span>
                </div>
                <div class="bg-white border border-gray-200/90 rounded-lg p-2">
                  <span class="text-[9px] uppercase font-bold text-gray-500 block">Potencia</span>
                  <span class="text-xs font-bold text-gray-900 truncate">{bike.power.split('/')[0]}</span>
                </div>
                <div class="bg-white border border-gray-200/90 rounded-lg p-2">
                  <span class="text-[9px] uppercase font-bold text-gray-500 block">Rendimiento</span>
                  <span class="text-xs font-bold text-gray-900">{bike.consumption}</span>
                </div>
              </div>

              <!-- Price & Actions -->
              <div class="pt-2 flex items-center justify-between">
                <div>
                  <span class="text-[10px] uppercase font-bold text-gray-500 block">Precio Referencial</span>
                  <span class="text-2xl font-black text-gray-900 font-['Teko',sans-serif] tracking-tight">
                    {bike.priceFromPen}
                  </span>
                </div>

                <div class="flex items-center gap-2">
                  <a
                    href={`/modelos/${bike.slug}`}
                    class="px-4 py-2 text-xs font-black uppercase tracking-wider text-white bg-[#FF0000] hover:bg-black rounded-full shadow-sm hover:shadow-md transition-all active:scale-95"
                  >
                    Ficha Técnica
                  </a>
                  <a
                    href={`https://wa.me/51981234567?text=${encodeURIComponent(`Hola Grupo Lauzher, deseo cotizar la moto ${bike.name} (${bike.priceFromPen}).\n\nModelo: ${Astro.url.origin}/modelos/${bike.slug}`)}`}
                    data-wa-slug={bike.slug}
                    data-wa-name={bike.name}
                    data-wa-price={bike.priceFromPen}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="card-wa-btn p-2 rounded-full border border-gray-300 hover:border-emerald-600 text-emerald-600 hover:bg-emerald-50 transition-all"
                    title="Cotizar por WhatsApp"
                  >
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                      <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 15 3.8 13.47 3.8 11.91C3.81 7.37 7.5 3.67 12.05 3.67M8.53 7.33C8.37 7.33 8.1 7.39 7.87 7.64C7.65 7.89 7.02 8.48 7.02 9.68C7.02 10.88 7.89 12.04 8.01 12.2C8.13 12.37 9.71 14.81 12.14 15.86C14.16 16.73 14.57 16.56 15.01 16.52C15.46 16.48 16.45 15.93 16.66 15.35C16.86 14.77 16.86 14.28 16.8 14.17C16.74 14.07 16.58 14.01 16.34 13.89C16.1 13.77 14.92 13.19 14.7 13.11C14.48 13.03 14.32 12.99 14.16 13.23C14 13.48 13.54 14.01 13.4 14.17C13.26 14.34 13.12 14.36 12.88 14.24C12.64 14.12 11.86 13.87 10.94 13.05C10.22 12.41 9.73 11.62 9.59 11.38C9.45 11.14 9.57 11 9.69 10.89C9.8 10.78 9.94 10.6 10.06 10.46C10.18 10.32 10.22 10.22 10.3 10.06C10.38 9.9 10.34 9.76 10.28 9.64C10.22 9.52 9.74 8.35 9.55 7.87C9.35 7.41 9.16 7.47 9.01 7.46C8.88 7.46 8.71 7.45 8.55 7.45L8.53 7.33Z"/>
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script>
  const catBtns = document.querySelectorAll('.catalog-cat-btn');
  const ccBtns = document.querySelectorAll('.catalog-cc-btn');
  const gridContainer = document.getElementById('catalog-grid');
  const cards = Array.from(document.querySelectorAll('.catalog-bike-card')) as HTMLElement[];

  let currentCat = 'todas';
  let currentCc = 'all';

  // Read URL query parameter ?cat=...
  const urlParams = new URLSearchParams(window.location.search);
  const initialCat = urlParams.get('cat');
  if (initialCat) {
    currentCat = initialCat;
  }

  // Attach Category button click listeners
  catBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      currentCat = btn.getAttribute('data-category') || 'todas';
      updateUI();
    });
  });

  // Attach CC button click listeners
  ccBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      currentCc = btn.getAttribute('data-cc') || 'all';
      updateUI();
    });
  });

  function updateUI() {
    // Determine available CCs for the currently selected category
    const availableCcs = new Set<string>();
    cards.forEach((card) => {
      const cat = card.getAttribute('data-category');
      const cc = card.getAttribute('data-cc');
      if (currentCat === 'todas' || cat === currentCat) {
        if (cc) availableCcs.add(cc);
      }
    });

    // If the currently selected CC is no longer available in this category, reset to 'all'
    if (currentCc !== 'all' && !availableCcs.has(currentCc)) {
      currentCc = 'all';
    }

    // Show or hide CC pills dynamically based on existence in selected category
    ccBtns.forEach((b) => {
      const btnCc = b.getAttribute('data-cc') || 'all';
      if (btnCc === 'all') {
        (b as HTMLElement).style.display = 'inline-block';
      } else if (availableCcs.has(btnCc)) {
        (b as HTMLElement).style.display = 'inline-block';
      } else {
        (b as HTMLElement).style.display = 'none';
      }
    });

    // Update category buttons active state and count badge styling
    catBtns.forEach((b) => {
      const badge = b.querySelector('.cat-badge');
      if (b.getAttribute('data-category') === currentCat) {
        b.classList.add('bg-[#FF0000]', 'text-white', 'border-[#FF0000]', 'shadow-md');
        b.classList.remove('bg-white', 'text-gray-700', 'border-gray-300');
        if (badge) {
          badge.classList.add('bg-black/20', 'text-white');
          badge.classList.remove('bg-gray-100', 'text-gray-700');
        }
      } else {
        b.classList.remove('bg-[#FF0000]', 'text-white', 'border-[#FF0000]', 'shadow-md');
        b.classList.add('bg-white', 'text-gray-700', 'border-gray-300');
        if (badge) {
          badge.classList.remove('bg-black/20', 'text-white');
          badge.classList.add('bg-gray-100', 'text-gray-700');
        }
      }
    });

    // Update CC buttons active state
    ccBtns.forEach((b) => {
      if (b.getAttribute('data-cc') === currentCc) {
        b.classList.add('bg-gray-900', 'text-white', 'border-gray-900');
        b.classList.remove('bg-white', 'text-gray-600', 'border-gray-300');
      } else {
        b.classList.remove('bg-gray-900', 'text-white', 'border-gray-900');
        b.classList.add('bg-white', 'text-gray-600', 'border-gray-300');
      }
    });

    // Keep natural catalog order
    const sortedCards = [...cards].sort((a, b) => {
      const idxA = parseInt(a.getAttribute('data-original-index') || '0', 10);
      const idxB = parseInt(b.getAttribute('data-original-index') || '0', 10);
      return idxA - idxB;
    });

    // Filter and append to DOM
    sortedCards.forEach((card) => {
      const cardCat = card.getAttribute('data-category');
      const cardCc = card.getAttribute('data-cc');

      const matchesCat = currentCat === 'todas' || cardCat === currentCat;
      const matchesCc = currentCc === 'all' || cardCc === currentCc;

      if (matchesCat && matchesCc) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }

      if (gridContainer) {
        gridContainer.appendChild(card);
      }
    });
  }

  // Initial trigger
  updateUI();

  // Ensure WhatsApp buttons include live origin URL for OpenGraph preview card
  document.querySelectorAll('.card-wa-btn').forEach((btn) => {
    const slug = btn.getAttribute('data-wa-slug');
    const name = btn.getAttribute('data-wa-name');
    const price = btn.getAttribute('data-wa-price');
    if (slug && name) {
      const modelUrl = `${window.location.origin}/modelos/${slug}`;
      const msg = `Hola Grupo Lauzher, deseo cotizar la moto ${name} (${price}).\n\nModelo: ${modelUrl}`;
      btn.setAttribute('href', `https://wa.me/51981234567?text=${encodeURIComponent(msg)}`);
    }
  });
</script>
