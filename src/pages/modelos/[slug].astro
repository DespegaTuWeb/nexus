---
import Layout from '../../layouts/Layout.astro';
import bikes from '../../data/bikes.json';
import site from '../../data/site.json';

export async function getStaticPaths() {
  return bikes.map((bike) => ({
    params: { slug: bike.slug },
    props: { bike },
  }));
}

const { bike } = Astro.props;

const relatedBikes = bikes.filter((b) => b.category === bike.category && b.id !== bike.id).slice(0, 3);
const ogImage = (bike.transparentImage || bike.image)
  .replace('/images/bikes/', '/images/og/')
  .replace(/\.(png|webp)$/i, '.jpg');
---

<Layout
  title={`${bike.name} (${bike.priceFromPen}) | Ficha Técnica y Crédito - Nexus Motos Grupo Lauzher`}
  description={`Conoce la ${bike.name} con motor ${bike.cc}, ${bike.power}. Precio desde ${bike.priceFromPen} (Cuotas desde ${bike.installmentsFrom}). Garantía oficial de Grupo Lauzher.`}
  image={ogImage}
>
  <!-- Breadcrumb -->
  <div class="bg-gray-50 border-b border-gray-200 py-3 px-6 text-xs text-gray-600">
    <div class="max-w-7xl mx-auto flex items-center gap-2">
      <a href="/" class="hover:text-black transition-colors font-medium">Inicio</a>
      <span>/</span>
      <a href="/modelos" class="hover:text-black transition-colors font-medium">Modelos</a>
      <span>/</span>
      <span class="text-[#FF0000] font-bold">{bike.name}</span>
    </div>
  </div>

  <!-- Hero Product Presentation in Pure White -->
  <section class="py-8 md:py-16 px-6 bg-white text-gray-900 border-b border-gray-200">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <!-- Left: Studio Image & Color Selector -->
      <div class="lg:col-span-7 flex flex-col items-center justify-center relative">
        <div class="relative w-full min-h-[260px] sm:min-h-[340px] md:min-h-[440px] flex items-center justify-center p-4 sm:p-6 bg-gradient-to-b from-gray-50 to-gray-100/70 rounded-2xl md:rounded-3xl border border-gray-200">
          <img
            id="detail-bike-img"
            src={bike.transparentImage}
            alt={bike.name}
            class="max-h-[380px] w-auto object-contain drop-shadow-[0_18px_24px_rgba(0,0,0,0.2)] transform hover:scale-105 transition-all duration-500"
          />
        </div>

        {bike.colors && bike.colors.length > 0 && (
          <div class="mt-6 flex flex-wrap items-center justify-center gap-2 sm:gap-4 bg-gray-50 border border-gray-200 rounded-2xl sm:rounded-full px-4 py-2 sm:px-5 sm:py-2.5 shadow-sm max-w-full">
            <span class="text-xs uppercase font-bold text-gray-600 tracking-wider">Colores:</span>
            <div class="flex items-center gap-2.5">
              {bike.colors.map((c: any) => (
                <div
                  class="flex items-center gap-1.5 cursor-pointer group"
                  title={c.name}
                >
                  <span
                    class="w-5 h-5 rounded-full border-2 border-white shadow-sm transition-transform group-hover:scale-125"
                    style={`background-color: ${c.hex};`}
                  ></span>
                  <span class="text-[11px] text-gray-700 font-medium hidden sm:inline">{c.name}</span>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>

      <!-- Right: Pricing, Specs & CTA -->
      <div class="lg:col-span-5 space-y-6">
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-[#FF0000] font-['Teko',sans-serif] text-lg">
            {bike.categoryLabel}
          </span>
          <h1 class="text-4xl md:text-6xl font-black uppercase text-gray-900 font-['Teko',sans-serif] tracking-tight leading-none">
            {bike.name}
          </h1>
          <p class="text-sm text-gray-600 mt-3 leading-relaxed">
            {bike.description}
          </p>
        </div>

        <!-- Pricing card -->
        <div class="bg-gray-50 border border-gray-200 rounded-2xl p-5 space-y-3">
          <div class="flex items-baseline justify-between">
            <div>
              <span class="text-[11px] uppercase font-bold text-gray-500 block">Precio Referencial</span>
              <span class="text-4xl md:text-5xl font-black text-gray-900 font-['Teko',sans-serif] tracking-tight">
                {bike.priceFromPen}
              </span>
            </div>
            <div class="text-right">
              <span class="text-[11px] uppercase font-bold text-gray-500 block">En Dólares</span>
              <span class="text-2xl font-bold text-gray-700 font-['Teko',sans-serif]">
                {bike.priceFromUsd}
              </span>
            </div>
          </div>

          <div class="pt-2 border-t border-gray-200 flex items-center justify-between text-xs text-gray-700">
            <span>Cuotas calculadas desde:</span>
            <span class="font-black text-emerald-700 text-sm font-mono">{bike.installmentsFrom}</span>
          </div>
        </div>

        <!-- Quick 4-box specs -->
        <div class="grid grid-cols-2 gap-3 text-center">
          <div class="bg-gray-50 border border-gray-200 rounded-xl p-3">
            <span class="text-[10px] uppercase font-bold text-gray-500 block">Cilindrada</span>
            <span class="text-lg font-black text-gray-900 font-['Teko',sans-serif]">{bike.cc}</span>
          </div>
          <div class="bg-gray-50 border border-gray-200 rounded-xl p-3">
            <span class="text-[10px] uppercase font-bold text-gray-500 block">Potencia</span>
            <span class="text-lg font-black text-gray-900 font-['Teko',sans-serif] truncate">{bike.power.split('/')[0]}</span>
          </div>
          <div class="bg-gray-50 border border-gray-200 rounded-xl p-3">
            <span class="text-[10px] uppercase font-bold text-gray-500 block">Transmisión</span>
            <span class="text-xs font-bold text-gray-900 block mt-1">{bike.transmission}</span>
          </div>
          <div class="bg-gray-50 border border-gray-200 rounded-xl p-3">
            <span class="text-[10px] uppercase font-bold text-gray-500 block">Consumo</span>
            <span class="text-xs font-bold text-gray-900 block mt-1">{bike.consumption}</span>
          </div>
        </div>

        <!-- Action CTAs -->
        <div class="space-y-3 pt-2">
          <a
            id="detail-whatsapp-btn"
            href={`https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(`Hola Grupo Lauzher, deseo cotizar la moto ${bike.name} (${bike.priceFromPen}) con el Combo Motero.\n\nModelo: ${Astro.url.href}`)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full py-4 px-6 rounded-full text-xs font-black uppercase tracking-wider text-white bg-emerald-600 hover:bg-emerald-700 shadow-md shadow-emerald-600/20 transition-all flex items-center justify-center gap-2"
          >
            Cotizar por WhatsApp con Asesor Oficial
          </a>
          <a
            href="/financiamiento"
            class="w-full py-3.5 px-6 rounded-full text-xs font-bold uppercase tracking-wider text-gray-800 border border-gray-300 hover:border-black transition-all flex items-center justify-center gap-2"
          >
            Simular Cuotas de Crédito con DNI
          </a>
        </div>

        <!-- High-Impact Visual Hook: Beneficios Incluidos por tu Compra (Light Theme) -->
        <div class="p-3.5 sm:p-5 rounded-2xl sm:rounded-3xl bg-gray-50 border border-gray-200 text-gray-900 shadow-md relative overflow-hidden">
          <!-- Header Row -->
          <div class="flex items-center justify-between border-b border-gray-200 pb-3 mb-3.5">
            <div>
              <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-emerald-100 text-emerald-800 border border-emerald-300">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                PACK MOTERO 100% INCLUIDO
              </span>
              <h3 class="text-2xl md:text-3xl font-black uppercase font-['Teko',sans-serif] tracking-wide text-gray-900 mt-1 leading-none">
                BENEFICIOS POR TU COMPRA
              </h3>
            </div>
            <a
              href="/combos-promociones"
              class="px-3 py-1.5 rounded-full bg-gray-900 hover:bg-black text-white text-[10px] font-bold uppercase transition-all tracking-wider shrink-0 shadow-sm"
            >
              Ver Más →
            </a>
          </div>

          <p class="text-xs text-gray-600 font-medium mb-3">
            Al comprar tu moto te la entregamos lista para rodar con este equipamiento oficial:
          </p>

          <!-- 6 Visual Hook Cards (1 col on iPhone SE/mobile, 2 cols on tablet/desktop) -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
            <!-- 1. Placa y Tarjeta -->
            <div class="bg-white hover:border-blue-300 border border-gray-200 rounded-2xl p-2.5 transition-all flex items-start gap-2.5 shadow-sm">
              <div class="w-10 h-10 rounded-xl bg-blue-50 border border-blue-200 text-blue-600 flex flex-col items-center justify-center shrink-0">
                <div class="w-7 h-4 bg-white rounded-[2px] border border-blue-600 flex flex-col items-center justify-center leading-none shadow-xs">
                  <span class="text-[4px] text-blue-700 font-bold -mb-0.5">PERÚ</span>
                  <span class="text-[5px] text-gray-900 font-black font-mono">NX-26</span>
                </div>
              </div>
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-1">
                  <span class="text-[8px] font-black uppercase px-1.5 py-0.2 rounded bg-blue-100 text-blue-800 border border-blue-200">SUNARP</span>
                </div>
                <h4 class="text-xs font-bold text-gray-900 uppercase font-['Teko',sans-serif] tracking-wide mt-0.5 leading-tight text-sm">
                  Tarjeta y Placa
                </h4>
                <p class="text-[10px] text-gray-500 leading-tight">Demora 15-20 días</p>
              </div>
            </div>

            <!-- 2. Casco Protector -->
            <div class="bg-white hover:border-emerald-300 border border-gray-200 rounded-2xl p-2.5 transition-all flex items-start gap-2.5 shadow-sm">
              <div class="w-10 h-10 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-600 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3C6.5 3 3 6.5 3 11c0 3 1.5 5.5 3.5 7l.5 3h10l.5-3c2-1.5 3.5-4 3.5-7 0-4.5-3.5-8-9-8z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M7 11h10c.5 0 1 .5 1 1.5s-.8 2.5-3 2.5H9c-2.2 0-3-1.5-3-2.5S6.5 11 7 11z" />
                </svg>
              </div>
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-1">
                  <span class="text-[8px] font-black uppercase px-1.5 py-0.2 rounded bg-emerald-100 text-emerald-800 border border-emerald-200">GRATIS</span>
                </div>
                <h4 class="text-xs font-bold text-gray-900 uppercase font-['Teko',sans-serif] tracking-wide mt-0.5 leading-tight text-sm">
                  Casco Protector
                </h4>
                <p class="text-[10px] text-gray-500 leading-tight">Sale rodando seguro</p>
              </div>
            </div>

            <!-- 3. Tres Mantenimientos (Emerald Green, No Red Warning) -->
            <div class="bg-white hover:border-emerald-300 border border-gray-200 rounded-2xl p-2.5 transition-all flex items-start gap-2.5 shadow-sm">
              <div class="w-10 h-10 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-600 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
                </svg>
              </div>
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-1">
                  <span class="text-[8px] font-black uppercase px-1.5 py-0.2 rounded bg-emerald-100 text-emerald-800 border border-emerald-200">MANO DE OBRA S/ 0</span>
                </div>
                <h4 class="text-xs font-bold text-gray-900 uppercase font-['Teko',sans-serif] tracking-wide mt-0.5 leading-tight text-sm">
                  03 Mantenimientos
                </h4>
                <p class="text-[10px] text-gray-500 leading-tight">Talleres autorizados</p>
              </div>
            </div>

            <!-- 4. Kit de Herramientas -->
            <div class="bg-white hover:border-slate-400 border border-gray-200 rounded-2xl p-2.5 transition-all flex items-start gap-2.5 shadow-sm">
              <div class="w-10 h-10 rounded-xl bg-slate-100 border border-slate-300 text-slate-700 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5V3a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" />
                </svg>
              </div>
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-1">
                  <span class="text-[8px] font-black uppercase px-1.5 py-0.2 rounded bg-slate-100 text-slate-800 border border-slate-300">EQUIPO</span>
                </div>
                <h4 class="text-xs font-bold text-gray-900 uppercase font-['Teko',sans-serif] tracking-wide mt-0.5 leading-tight text-sm">
                  Kit Herramientas
                </h4>
                <p class="text-[10px] text-gray-500 leading-tight">Básico emergencias</p>
              </div>
            </div>

            <!-- 5. Aceite de Activación -->
            <div class="bg-white hover:border-cyan-300 border border-gray-200 rounded-2xl p-2.5 transition-all flex items-start gap-2.5 shadow-sm">
              <div class="w-10 h-10 rounded-xl bg-cyan-50 border border-cyan-200 text-cyan-600 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2v4m0 0l-3 4h6l-3-4zm-5 8h10a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-6a2 2 0 0 1 2-2z" />
                </svg>
              </div>
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-1">
                  <span class="text-[8px] font-black uppercase px-1.5 py-0.2 rounded bg-cyan-100 text-cyan-800 border border-cyan-200">ACTIVACIÓN</span>
                </div>
                <h4 class="text-xs font-bold text-gray-900 uppercase font-['Teko',sans-serif] tracking-wide mt-0.5 leading-tight text-sm">
                  Aceite Motor
                </h4>
                <p class="text-[10px] text-gray-500 leading-tight">Primer encendido</p>
              </div>
            </div>

            <!-- 6. Garantía Oficial -->
            <div class="bg-white hover:border-purple-300 border border-gray-200 rounded-2xl p-2.5 transition-all flex items-start gap-2.5 shadow-sm">
              <div class="w-10 h-10 rounded-xl bg-purple-50 border border-purple-200 text-purple-600 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
              <div class="min-w-0 flex-1">
                <div class="flex items-center gap-1">
                  <span class="text-[8px] font-black uppercase px-1.5 py-0.2 rounded bg-purple-100 text-purple-800 border border-purple-200">1 AÑO / 12,000 KM</span>
                </div>
                <h4 class="text-xs font-bold text-gray-900 uppercase font-['Teko',sans-serif] tracking-wide mt-0.5 leading-tight text-sm">
                  Garantía Oficial
                </h4>
                <p class="text-[10px] text-gray-500 leading-tight">Sólo Motor • Lauzher</p>
              </div>
            </div>
          </div>

          <!-- Bottom Assurance Note -->
          <div class="mt-3 pt-3 border-t border-gray-200 flex flex-wrap items-center justify-between gap-2 text-[11px] text-gray-500">
            <span class="flex items-center gap-1.5 text-emerald-700 font-semibold">
              <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
              Entrega formal con respaldo técnico de Grupo Lauzher
            </span>
            <span class="text-[10px] text-gray-400 font-medium shrink-0">Validez nacional</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Specs in Clean Light Gray -->
  <section class="py-10 md:py-16 px-6 bg-gray-50 border-t border-gray-200" id="especificaciones">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-6 md:mb-12">
        <span class="text-xs font-bold text-gray-500 uppercase tracking-widest font-['Teko',sans-serif] text-base">
          INGENIERÍA Y RENDIMIENTO
        </span>
        <h2 class="text-4xl md:text-5xl font-black uppercase text-gray-900 font-['Teko',sans-serif] tracking-tight">
          FICHA TÉCNICA DETALLADA
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Table 1 -->
        <div class="bg-white border border-gray-200 rounded-2xl p-6 space-y-4 shadow-sm">
          <h3 class="text-xl font-bold uppercase text-gray-900 font-['Teko',sans-serif] tracking-wide border-b border-gray-200 pb-2">
            Motor y Prestaciones
          </h3>
          <div class="space-y-2.5 text-xs">
            <div class="flex justify-between py-1 border-b border-gray-100">
              <span class="text-gray-500 font-medium">Cilindrada:</span>
              <span class="text-gray-900 font-bold">{bike.cc}</span>
            </div>
            <div class="flex justify-between py-1 border-b border-gray-100">
              <span class="text-gray-500 font-medium">Potencia Máxima:</span>
              <span class="text-gray-900 font-bold">{bike.power}</span>
            </div>
            <div class="flex justify-between py-1 border-b border-gray-100">
              <span class="text-gray-500 font-medium">Torque Máximo:</span>
              <span class="text-gray-900 font-bold">{bike.torque}</span>
            </div>
            <div class="flex justify-between py-1 border-b border-gray-100">
              <span class="text-gray-500 font-medium">Sistema de Combustible:</span>
              <span class="text-gray-900 font-bold">{bike.fuelSystem}</span>
            </div>
            <div class="flex justify-between py-1 border-b border-gray-100">
              <span class="text-gray-500 font-medium">Refrigeración:</span>
              <span class="text-gray-900 font-bold">{bike.cooling}</span>
            </div>
            <div class="flex justify-between py-1">
              <span class="text-gray-500 font-medium">Velocidad Máxima Aprox:</span>
              <span class="text-gray-900 font-bold">{bike.maxSpeed}</span>
            </div>
          </div>
        </div>

        <!-- Table 2 -->
        <div class="bg-white border border-gray-200 rounded-2xl p-6 space-y-4 shadow-sm">
          <h3 class="text-xl font-bold uppercase text-gray-900 font-['Teko',sans-serif] tracking-wide border-b border-gray-200 pb-2">
            Chasis, Frenos y Autonomía
          </h3>
          <div class="space-y-2.5 text-xs">
            <div class="flex justify-between py-1 border-b border-gray-100">
              <span class="text-gray-500 font-medium">Transmisión:</span>
              <span class="text-gray-900 font-bold">{bike.transmission}</span>
            </div>
            <div class="flex justify-between py-1 border-b border-gray-100">
              <span class="text-gray-500 font-medium">Sistema de Frenos:</span>
              <span class="text-gray-900 font-bold">{bike.brakes}</span>
            </div>
            <div class="flex justify-between py-1 border-b border-gray-100">
              <span class="text-gray-500 font-medium">Capacidad de Tanque:</span>
              <span class="text-gray-900 font-bold">{bike.tankCapacity}</span>
            </div>
            <div class="flex justify-between py-1 border-b border-gray-100">
              <span class="text-gray-500 font-medium">Consumo Estimado:</span>
              <span class="text-gray-900 font-bold">{bike.consumption}</span>
            </div>
            <div class="flex justify-between py-1 border-b border-gray-100">
              <span class="text-gray-500 font-medium">Peso en Seco:</span>
              <span class="text-gray-900 font-bold">{bike.weight}</span>
            </div>
            <div class="flex justify-between py-1">
              <span class="text-gray-500 font-medium">Garantía Oficial:</span>
              <span class="text-emerald-700 font-bold">1 año o 12,000KM, lo que suceda primero (Sólo Motor)</span>
            </div>
          </div>
        </div>
      </div>

      {bike.highlights && (
        <div class="mt-8 bg-white border border-gray-200 rounded-2xl p-6 shadow-sm">
          <h3 class="text-xl font-bold uppercase text-gray-900 font-['Teko',sans-serif] tracking-wide mb-4">
            Equipamiento Destacado
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {bike.highlights.map((h: string) => (
              <div class="flex items-center gap-2 text-xs text-gray-700">
                <svg class="w-4 h-4 text-emerald-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
                <span>{h}</span>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Related Bikes in Clean White -->
  {relatedBikes.length > 0 && (
    <section class="py-16 px-6 bg-white border-t border-gray-200">
      <div class="max-w-7xl mx-auto">
        <h2 class="text-3xl font-black uppercase text-gray-900 font-['Teko',sans-serif] tracking-tight mb-8">
          Modelos Relacionados
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {relatedBikes.map((rel) => (
            <a
              href={`/modelos/${rel.slug}`}
              class="bg-gray-50 hover:bg-white border border-gray-200 hover:border-gray-300 rounded-2xl p-5 transition-all group flex flex-col justify-between shadow-sm hover:shadow-md"
            >
              <div class="h-44 flex items-center justify-center p-2">
                <img
                  src={rel.transparentImage}
                  alt={rel.name}
                  class="max-h-36 w-auto object-contain transition-transform group-hover:scale-105 drop-shadow-[0_8px_12px_rgba(0,0,0,0.15)]"
                  loading="lazy"
                />
              </div>
              <div class="pt-3 border-t border-gray-200 flex items-center justify-between">
                <div>
                  <h3 class="text-lg font-black uppercase text-gray-900 font-['Teko',sans-serif]">
                    {rel.name}
                  </h3>
                  <span class="text-xs text-gray-500 font-medium">{rel.cc}</span>
                </div>
                <span class="text-gray-900 font-bold text-sm">{rel.priceFromPen}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <script define:vars={{ whatsappNumber: site.whatsappNumber, bikeName: bike.name, bikePrice: bike.priceFromPen }}>
    const waBtn = document.getElementById('detail-whatsapp-btn');
    if (waBtn && typeof window !== 'undefined') {
      const msg = `Hola Grupo Lauzher, deseo cotizar la moto ${bikeName} (${bikePrice}) con el Combo Motero.\n\nModelo: ${window.location.href}`;
      waBtn.setAttribute('href', `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(msg)}`);
    }
  </script>
</Layout>
