---
import Layout from '../../layouts/Layout.astro';
import bikes from '../../data/bikes.json';
import site from '../../data/site.json';

export async function getStaticPaths() {
  return bikes.map((bike) => ({
    params: { slug: bike.slug },
    props: { bike },
  }));
}

const { bike } = Astro.props;

const relatedBikes = bikes.filter((b) => b.category === bike.category && b.id !== bike.id).slice(0, 3);
const ogImage = (bike.transparentImage || bike.image)
  .replace('/images/bikes/', '/images/og/')
  .replace(/\.(png|webp)$/i, '.jpg');
---

<Layout
  title={`${bike.name} (${bike.priceFromPen}) | Ficha Técnica y Crédito - Nexus Motos Grupo Lauzher`}
  description={`Conoce la ${bike.name} con motor ${bike.cc}, ${bike.power}. Precio desde ${bike.priceFromPen} (Cuotas desde ${bike.installmentsFrom}). Garantía oficial de Grupo Lauzher.`}
  image={ogImage}
>
  <!-- Breadcrumb -->
  <div class="bg-gray-50 border-b border-gray-200 py-3 px-6 text-xs text-gray-600">
    <div class="max-w-7xl mx-auto flex items-center gap-2">
      <a href="/" class="hover:text-black transition-colors font-medium">Inicio</a>
      <span>/</span>
      <a href="/modelos" class="hover:text-black transition-colors font-medium">Modelos</a>
      <span>/</span>
      <span class="text-[#FF0000] font-bold">{bike.name}</span>
    </div>
  </div>

  <!-- Hero Product Presentation in Pure White -->
  <section class="py-12 md:py-16 px-6 bg-white text-gray-900 border-b border-gray-200">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      <!-- Left: Studio Image & Color Selector -->
      <div class="lg:col-span-7 flex flex-col items-center justify-center relative">
        <div class="relative w-full min-h-[340px] md:min-h-[440px] flex items-center justify-center p-6 bg-gradient-to-b from-gray-50 to-gray-100/70 rounded-3xl border border-gray-200">
          <img
            id="detail-bike-img"
            src={bike.transparentImage}
            alt={bike.name}
            class="max-h-[380px] w-auto object-contain drop-shadow-[0_18px_24px_rgba(0,0,0,0.2)] transform hover:scale-105 transition-all duration-500"
          />
        </div>

        {bike.colors && bike.colors.length > 0 && (
          <div class="mt-6 flex items-center gap-4 bg-gray-50 border border-gray-200 rounded-full px-5 py-2.5 shadow-sm">
            <span class="text-xs uppercase font-bold text-gray-600 tracking-wider">Colores Disponibles:</span>
            <div class="flex items-center gap-2.5">
              {bike.colors.map((c: any) => (
                <div
                  class="flex items-center gap-1.5 cursor-pointer group"
                  title={c.name}
                >
                  <span
                    class="w-5 h-5 rounded-full border-2 border-white shadow-sm transition-transform group-hover:scale-125"
                    style={`background-color: ${c.hex};`}
                  ></span>
                  <span class="text-[11px] text-gray-700 font-medium hidden sm:inline">{c.name}</span>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>

      <!-- Right: Pricing, Specs & CTA -->
      <div class="lg:col-span-5 space-y-6">
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-[#FF0000] font-['Teko',sans-serif] text-lg">
            {bike.categoryLabel}
          </span>
          <h1 class="text-4xl md:text-6xl font-black uppercase text-gray-900 font-['Teko',sans-serif] tracking-tight leading-none">
            {bike.name}
          </h1>
          <p class="text-sm text-gray-600 mt-3 leading-relaxed">
            {bike.description}
          </p>
        </div>

        <!-- Pricing card -->
        <div class="bg-gray-50 border border-gray-200 rounded-2xl p-5 space-y-3">
          <div class="flex items-baseline justify-between">
            <div>
              <span class="text-[11px] uppercase font-bold text-gray-500 block">Precio Referencial</span>
              <span class="text-4xl md:text-5xl font-black text-gray-900 font-['Teko',sans-serif] tracking-tight">
                {bike.priceFromPen}
              </span>
            </div>
            <div class="text-right">
              <span class="text-[11px] uppercase font-bold text-gray-500 block">En Dólares</span>
              <span class="text-2xl font-bold text-gray-700 font-['Teko',sans-serif]">
                {bike.priceFromUsd}
              </span>
            </div>
          </div>

          <div class="pt-2 border-t border-gray-200 flex items-center justify-between text-xs text-gray-700">
            <span>Cuotas calculadas desde:</span>
            <span class="font-black text-emerald-700 text-sm font-mono">{bike.installmentsFrom}</span>
          </div>
        </div>

        <!-- Quick 4-box specs -->
        <div class="grid grid-cols-2 gap-3 text-center">
          <div class="bg-gray-50 border border-gray-200 rounded-xl p-3">
            <span class="text-[10px] uppercase font-bold text-gray-500 block">Cilindrada</span>
            <span class="text-lg font-black text-gray-900 font-['Teko',sans-serif]">{bike.cc}</span>
          </div>
          <div class="bg-gray-50 border border-gray-200 rounded-xl p-3">
            <span class="text-[10px] uppercase font-bold text-gray-500 block">Potencia</span>
            <span class="text-lg font-black text-gray-900 font-['Teko',sans-serif] truncate">{bike.power.split('/')[0]}</span>
          </div>
          <div class="bg-gray-50 border border-gray-200 rounded-xl p-3">
            <span class="text-[10px] uppercase font-bold text-gray-500 block">Transmisión</span>
            <span class="text-xs font-bold text-gray-900 block mt-1">{bike.transmission}</span>
          </div>
          <div class="bg-gray-50 border border-gray-200 rounded-xl p-3">
            <span class="text-[10px] uppercase font-bold text-gray-500 block">Consumo</span>
            <span class="text-xs font-bold text-gray-900 block mt-1">{bike.consumption}</span>
          </div>
        </div>

        <!-- Action CTAs -->
        <div class="space-y-3 pt-2">
          <a
            id="detail-whatsapp-btn"
            href={`https://wa.me/${site.whatsappNumber}?text=${encodeURIComponent(`Hola Grupo Lauzher, deseo cotizar la moto ${bike.name} (${bike.priceFromPen}) con el Combo Motero.\n\nModelo: ${Astro.url.href}`)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full py-4 px-6 rounded-full text-xs font-black uppercase tracking-wider text-white bg-emerald-600 hover:bg-emerald-700 shadow-md shadow-emerald-600/20 transition-all flex items-center justify-center gap-2"
          >
            Cotizar por WhatsApp con Asesor Oficial
          </a>
          <a
            href="/financiamiento"
            class="w-full py-3.5 px-6 rounded-full text-xs font-bold uppercase tracking-wider text-gray-800 border border-gray-300 hover:border-black transition-all flex items-center justify-center gap-2"
          >
            Simular Cuotas de Crédito con DNI
          </a>
        </div>

        <!-- Official Client Purchase Benefits Box -->
        <div class="p-4 rounded-2xl bg-amber-50/90 border border-amber-200/90 text-xs text-gray-800 space-y-2.5 shadow-sm">
          <div class="flex items-center justify-between border-b border-amber-200/80 pb-2">
            <span class="font-bold text-gray-900 uppercase font-['Teko',sans-serif] text-xl tracking-wide flex items-center gap-1.5">
              🎁 Beneficios Incluidos por tu Compra:
            </span>
            <a
              href="/combos-promociones"
              class="px-2.5 py-1 rounded bg-gray-900 text-white text-[10px] font-bold uppercase hover:bg-black transition-colors"
            >
              Ver Detalles
            </a>
          </div>

          <p class="text-xs text-gray-700 font-semibold">
            Estimado Cliente, por la compra de su unidad, se le incluyen estos beneficios:
          </p>

          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-1.5 text-xs text-gray-800 font-medium">
            <li class="flex items-center gap-1.5">📍 Trámite de tarjeta y placa</li>
            <li class="flex items-center gap-1.5">📍 Casco</li>
            <li class="flex items-center gap-1.5">📍 Kit básico de herramientas</li>
            <li class="flex items-center gap-1.5">📍 Aceite (Activación de la unidad)</li>
          </ul>

          <div class="pt-2 text-[11px] text-amber-950 font-semibold space-y-1 border-t border-amber-200/80">
            <p>🛠️ Los 03 primeros Mantenimientos son GRATIS (mano de obra) 😉</p>
            <p>⏱️ Asimismo, el trámite de tarjeta y placa tiene una demora máximo de 15 a 20 días hábiles.</p>
            <p>🏅 Garantía por 1 año o 12,000KM, lo que suceda primero. (Sólo Motor)</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Specs in Clean Light Gray -->
  <section class="py-16 px-6 bg-gray-50 border-t border-gray-200" id="especificaciones">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12">
        <span class="text-xs font-bold text-gray-500 uppercase tracking-widest font-['Teko',sans-serif] text-base">
          INGENIERÍA Y RENDIMIENTO
        </span>
        <h2 class="text-4xl md:text-5xl font-black uppercase text-gray-900 font-['Teko',sans-serif] tracking-tight">
          FICHA TÉCNICA DETALLADA
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Table 1 -->
        <div class="bg-white border border-gray-200 rounded-2xl p-6 space-y-4 shadow-sm">
          <h3 class="text-xl font-bold uppercase text-gray-900 font-['Teko',sans-serif] tracking-wide border-b border-gray-200 pb-2">
            Motor y Prestaciones
          </h3>
          <div class="space-y-2.5 text-xs">
            <div class="flex justify-between py-1 border-b border-gray-100">
              <span class="text-gray-500 font-medium">Cilindrada:</span>
              <span class="text-gray-900 font-bold">{bike.cc}</span>
            </div>
            <div class="flex justify-between py-1 border-b border-gray-100">
              <span class="text-gray-500 font-medium">Potencia Máxima:</span>
              <span class="text-gray-900 font-bold">{bike.power}</span>
            </div>
            <div class="flex justify-between py-1 border-b border-gray-100">
              <span class="text-gray-500 font-medium">Torque Máximo:</span>
              <span class="text-gray-900 font-bold">{bike.torque}</span>
            </div>
            <div class="flex justify-between py-1 border-b border-gray-100">
              <span class="text-gray-500 font-medium">Sistema de Combustible:</span>
              <span class="text-gray-900 font-bold">{bike.fuelSystem}</span>
            </div>
            <div class="flex justify-between py-1 border-b border-gray-100">
              <span class="text-gray-500 font-medium">Refrigeración:</span>
              <span class="text-gray-900 font-bold">{bike.cooling}</span>
            </div>
            <div class="flex justify-between py-1">
              <span class="text-gray-500 font-medium">Velocidad Máxima Aprox:</span>
              <span class="text-gray-900 font-bold">{bike.maxSpeed}</span>
            </div>
          </div>
        </div>

        <!-- Table 2 -->
        <div class="bg-white border border-gray-200 rounded-2xl p-6 space-y-4 shadow-sm">
          <h3 class="text-xl font-bold uppercase text-gray-900 font-['Teko',sans-serif] tracking-wide border-b border-gray-200 pb-2">
            Chasis, Frenos y Autonomía
          </h3>
          <div class="space-y-2.5 text-xs">
            <div class="flex justify-between py-1 border-b border-gray-100">
              <span class="text-gray-500 font-medium">Transmisión:</span>
              <span class="text-gray-900 font-bold">{bike.transmission}</span>
            </div>
            <div class="flex justify-between py-1 border-b border-gray-100">
              <span class="text-gray-500 font-medium">Sistema de Frenos:</span>
              <span class="text-gray-900 font-bold">{bike.brakes}</span>
            </div>
            <div class="flex justify-between py-1 border-b border-gray-100">
              <span class="text-gray-500 font-medium">Capacidad de Tanque:</span>
              <span class="text-gray-900 font-bold">{bike.tankCapacity}</span>
            </div>
            <div class="flex justify-between py-1 border-b border-gray-100">
              <span class="text-gray-500 font-medium">Consumo Estimado:</span>
              <span class="text-gray-900 font-bold">{bike.consumption}</span>
            </div>
            <div class="flex justify-between py-1 border-b border-gray-100">
              <span class="text-gray-500 font-medium">Peso en Seco:</span>
              <span class="text-gray-900 font-bold">{bike.weight}</span>
            </div>
            <div class="flex justify-between py-1">
              <span class="text-gray-500 font-medium">Garantía Oficial:</span>
              <span class="text-emerald-700 font-bold">1 año o 12,000KM, lo que suceda primero (Sólo Motor)</span>
            </div>
          </div>
        </div>
      </div>

      {bike.highlights && (
        <div class="mt-8 bg-white border border-gray-200 rounded-2xl p-6 shadow-sm">
          <h3 class="text-xl font-bold uppercase text-gray-900 font-['Teko',sans-serif] tracking-wide mb-4">
            Equipamiento Destacado
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {bike.highlights.map((h: string) => (
              <div class="flex items-center gap-2 text-xs text-gray-700">
                <svg class="w-4 h-4 text-emerald-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
                <span>{h}</span>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Related Bikes in Clean White -->
  {relatedBikes.length > 0 && (
    <section class="py-16 px-6 bg-white border-t border-gray-200">
      <div class="max-w-7xl mx-auto">
        <h2 class="text-3xl font-black uppercase text-gray-900 font-['Teko',sans-serif] tracking-tight mb-8">
          Modelos Relacionados
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {relatedBikes.map((rel) => (
            <a
              href={`/modelos/${rel.slug}`}
              class="bg-gray-50 hover:bg-white border border-gray-200 hover:border-gray-300 rounded-2xl p-5 transition-all group flex flex-col justify-between shadow-sm hover:shadow-md"
            >
              <div class="h-44 flex items-center justify-center p-2">
                <img
                  src={rel.transparentImage}
                  alt={rel.name}
                  class="max-h-36 w-auto object-contain transition-transform group-hover:scale-105 drop-shadow-[0_8px_12px_rgba(0,0,0,0.15)]"
                  loading="lazy"
                />
              </div>
              <div class="pt-3 border-t border-gray-200 flex items-center justify-between">
                <div>
                  <h3 class="text-lg font-black uppercase text-gray-900 font-['Teko',sans-serif]">
                    {rel.name}
                  </h3>
                  <span class="text-xs text-gray-500 font-medium">{rel.cc}</span>
                </div>
                <span class="text-gray-900 font-bold text-sm">{rel.priceFromPen}</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <script define:vars={{ whatsappNumber: site.whatsappNumber, bikeName: bike.name, bikePrice: bike.priceFromPen }}>
    const waBtn = document.getElementById('detail-whatsapp-btn');
    if (waBtn && typeof window !== 'undefined') {
      const msg = `Hola Grupo Lauzher, deseo cotizar la moto ${bikeName} (${bikePrice}) con el Combo Motero.\n\nModelo: ${window.location.href}`;
      waBtn.setAttribute('href', `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(msg)}`);
    }
  </script>
</Layout>
