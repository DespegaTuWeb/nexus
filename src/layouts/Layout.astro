---
import '../styles/global.css';
import site from '../data/site.json';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
}

const siteOrigin = Astro.site ? Astro.site.origin : Astro.url.origin;
const {
  title = "Nexus Motos Perú | Grupo Lauzher - Catálogo Oficial y Financiamiento",
  description = "Nexus Motos en Perú. Principal importador: Grupo Lauzher. Conoce nuestras motos deportivas, pisteras, scooters, todoterreno y cafe racer. Crédito directo con DNI y Combo Motero con Casco y Placa.",
  image = "/images/og/deportiva-250-rsport.jpg",
  canonicalUrl = new URL(Astro.url.pathname, siteOrigin).href,
} = Astro.props;

const absoluteImageUrl = image.startsWith('http') ? image : new URL(image, siteOrigin).href;
---

<!doctype html>
<html lang="es" class="scroll-smooth overflow-x-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png?v=2" />
    <link rel="shortcut icon" href="/favicon.ico?v=2" />
    <link rel="apple-touch-icon" href="/favicon.png?v=2" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteImageUrl} />
    <meta property="og:image:secure_url" content={absoluteImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Nexus Motos Perú - Grupo Lauzher" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800;900&family=Teko:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-white text-gray-900 min-h-screen flex flex-col selection:bg-[#FF0000] selection:text-white overflow-x-hidden w-full relative">
    <Navbar />

    <main class="flex-grow">
      <slot />
    </main>

    <Footer />
    <WhatsAppButton />
  </body>
</html>
