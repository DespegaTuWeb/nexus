---
import NexusLogo from './NexusLogo.astro';
import site from '../data/site.json';

const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/modelos', label: 'Modelos', match: ['/modelos'] },
  { href: '/combos-promociones', label: 'Beneficios', match: ['/combos-promociones'] },
  { href: '/financiamiento', label: 'Financiamiento', match: ['/financiamiento'] },
  { href: '/contacto', label: 'Ubícanos', match: ['/contacto', '/concesionarios'] },
];
---

<header class="sticky top-0 z-50 w-full transition-all">
  <!-- Minimalist utility bar in black (Address & Contact only — zero duplication with logo) -->
  <div class="bg-[#0a0b0e] border-b border-white/10 text-xs text-gray-300 py-2 px-6 hidden md:block">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
      <div class="flex items-center gap-6">
        <a
          href={site.mainMapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1.5 text-gray-300 hover:text-white hover:underline transition-colors"
          title="Ver en Google Maps"
        >
          <svg class="w-3.5 h-3.5 text-gray-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span>{site.mainAddress}</span>
        </a>
      </div>

      <div class="flex items-center gap-6">
        <a href={`tel:${site.centralPhone.replace(/[^0-9]/g, '')}`} class="text-gray-300 hover:text-white transition-colors flex items-center gap-1.5 font-medium">
          <svg class="w-3.5 h-3.5 text-gray-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          Central: {site.centralPhone}
        </a>
        <a
          href={`https://wa.me/${site.whatsappNumber}?text=Hola%20Nexus%20Motos%20Grupo%20Lauzher,%20deseo%20información`}
          target="_blank"
          rel="noopener noreferrer"
          class="text-emerald-400 hover:text-emerald-300 transition-colors font-semibold flex items-center gap-1.5"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          WhatsApp Ventas: {site.centralMobile}
        </a>
      </div>
    </div>
  </div>

  <!-- Main Navbar in clean White (4 core items + 1 single visual focal CTA) -->
  <nav class="bg-white/95 backdrop-blur-md border-b border-gray-200 px-6 py-3.5 shadow-sm">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-6">
      <NexusLogo variant="light" />

      <!-- Desktop Links (Hick's Law: 4 clean pillars with generous spacing) -->
      <div class="hidden lg:flex items-center gap-4 xl:gap-7">
        {navLinks.map((link) => {
          const isActive = link.match.some((m) => currentPath === m || currentPath.startsWith(m + '/'));
          return (
            <a
              href={link.href}
              class={`relative px-3 py-2 text-xs xl:text-sm font-semibold uppercase tracking-wider whitespace-nowrap transition-all duration-200 rounded-md ${
                isActive
                  ? 'text-gray-900 bg-gray-100 border-b-2 border-gray-900 font-bold'
                  : 'text-gray-700 hover:text-gray-900 hover:bg-gray-100/70'
              }`}
            >
              {link.label}
            </a>
          );
        })}
      </div>

      <!-- Single Visual Focal Point CTA (Von Restorff Effect) -->
      <div class="hidden sm:flex items-center gap-3 shrink-0">
        <a
          href={`https://wa.me/${site.whatsappNumber}?text=Hola%20Nexus%20Motos,%20deseo%20cotizar%20un%20modelo%20con%20el%20Combo%20Motero`}
          target="_blank"
          rel="noopener noreferrer"
          class="px-5 py-2.5 text-xs font-bold uppercase tracking-wider whitespace-nowrap text-white bg-emerald-600 hover:bg-emerald-700 active:scale-95 rounded-full shadow-md shadow-emerald-600/20 transition-all flex items-center gap-1.5"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          Cotizar Ahora
        </a>
      </div>

      <!-- Mobile hamburger -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="lg:hidden p-2 rounded-lg text-gray-700 hover:text-black hover:bg-gray-100 focus:outline-none"
        aria-label="Abrir menú"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Drawer in clean White -->
  <div id="mobile-menu" class="hidden lg:hidden bg-white border-b border-gray-200 px-4 py-5 space-y-3 shadow-xl">
    <div class="flex flex-col space-y-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="flex items-center justify-between px-3 py-2.5 text-base font-semibold text-gray-800 hover:bg-gray-100 hover:text-gray-900 rounded-md transition-colors"
        >
          <span>{link.label}</span>
        </a>
      ))}
    </div>

    <div class="pt-4 border-t border-gray-200 space-y-2">
      <a
        href="/financiamiento"
        class="block text-center w-full py-2.5 text-sm font-bold uppercase text-gray-800 border border-gray-300 rounded-lg hover:bg-gray-50"
      >
        Simular Financiamiento
      </a>
      <a
        href={`https://wa.me/${site.whatsappNumber}?text=Hola%20Nexus%20Motos,%20deseo%20información`}
        target="_blank"
        rel="noopener noreferrer"
        class="block text-center w-full py-2.5 text-sm font-bold uppercase text-white bg-emerald-600 hover:bg-emerald-700 rounded-lg shadow-md transition-colors"
      >
        WhatsApp Oficial
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
