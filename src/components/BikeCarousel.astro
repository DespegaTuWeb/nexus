---
import bikes from '../data/bikes.json';

const categories = [
  { id: 'todas', label: 'Todas' },
  { id: 'pisteras', label: 'Pisteras' },
  { id: 'deportivas', label: 'Deportivas' },
  { id: 'scooter', label: 'Scooters' },
  { id: 'todoterreno', label: 'Todoterreno' },
  { id: 'caferacer', label: 'Cafe Racer' }
];
---

<section class="py-20 bg-[#fafafa] text-gray-900 border-t border-gray-200" id="catalogo-selector">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6 mb-12">
      <div>
        <h2 class="text-4xl md:text-6xl font-black text-gray-900 tracking-tight font-['Teko',sans-serif]">
          ELIGE TU NUEVA <span class="text-[#FF0000]">NEXUS</span>
        </h2>
        <p class="text-sm text-gray-500 font-medium">Modelos con respaldo oficial de Grupo Lauzher en todo el Perú</p>
      </div>

      <div class="flex items-center gap-1.5 overflow-x-auto pb-2 lg:pb-0 scrollbar-none" id="category-tabs">
        {categories.map((cat, i) => (
          <button
            class={`category-filter-btn px-5 py-2.5 rounded-full text-xs md:text-sm font-bold tracking-wider uppercase border transition-all duration-200 whitespace-nowrap cursor-pointer ${
              i === 0
                ? 'bg-[#0f1118] text-white border-[#0f1118] shadow-md active-category'
                : 'bg-white text-gray-600 hover:text-black hover:bg-gray-200/80 border-gray-200/80'
            }`}
            data-category={cat.id}
          >
            {cat.label}
          </button>
        ))}
      </div>
    </div>

    <!-- Filter & Sort Toolbar -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6 bg-white p-3 rounded-2xl border border-gray-200/80 shadow-sm">
      <div class="flex items-center gap-1.5 overflow-x-auto pb-1 sm:pb-0 scrollbar-none">
        <span class="text-xs font-bold uppercase text-gray-500 mr-1">Cilindrada:</span>
        {['all', '125', '150', '200', '250'].map((ccVal, idx) => (
          <button
            class={`carousel-cc-btn px-3 py-1 rounded-full text-xs font-bold uppercase transition-all cursor-pointer ${
              idx === 0
                ? 'bg-gray-900 text-white'
                : 'bg-gray-100 text-gray-600 hover:bg-gray-200'
            }`}
            data-cc={ccVal}
          >
            {ccVal === 'all' ? 'Todas' : `${ccVal} cc`}
          </button>
        ))}
      </div>

      <div class="flex items-center gap-2 justify-end">
        <label for="home-sort" class="text-xs font-bold uppercase text-gray-500 whitespace-nowrap">
          Ordenar:
        </label>
        <select
          id="home-sort"
          class="text-xs font-bold uppercase tracking-wider bg-gray-50 border border-gray-200 rounded-lg px-2.5 py-1 text-gray-800 focus:outline-none focus:ring-2 focus:ring-[#FF0000] cursor-pointer"
        >
          <option value="default">Precio: Menor a Mayor (Por defecto)</option>
          <option value="price-desc">Precio: Mayor a Menor</option>
          <option value="cc-asc">Cilindrada: 125cc → 250cc</option>
          <option value="cc-desc">Cilindrada: 250cc → 125cc</option>
        </select>
      </div>
    </div>

    <div class="relative">
      <div
        id="bike-cards-container"
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 transition-all duration-300"
      >
        {bikes.map((bike, index) => (
          <div
            class="bike-card group bg-[#f3f4f6] hover:bg-white rounded-2xl p-5 border border-transparent hover:border-gray-200 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between"
            data-category={bike.category}
            data-cc={parseInt(bike.cc.replace('cc', '').trim())}
            data-price={bike.rawPricePen}
            data-original-index={index}
          >
            <div class="relative w-full h-52 flex items-center justify-center p-2 mb-4 rounded-xl overflow-hidden bg-gray-200">
              <img
                src={`/images/categories/bg-${bike.category}.jpg`}
                alt=""
                aria-hidden="true"
                class="absolute inset-0 w-full h-full object-cover object-center opacity-80 brightness-110 transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
              />
              <!-- Bright central spotlight so dark/red bikes never blend into the background -->
              <div class="absolute inset-0 bg-[radial-gradient(ellipse_75%_70%_at_50%_55%,rgba(255,255,255,0.92)_0%,rgba(255,255,255,0.72)_45%,rgba(255,255,255,0.22)_80%,transparent_100%)] pointer-events-none"></div>
              <!-- Ground shadow under wheels -->
              <div class="absolute bottom-3 left-1/2 -translate-x-1/2 w-2/3 h-3 bg-black/30 blur-md rounded-full pointer-events-none"></div>

              <img
                src={bike.transparentImage}
                alt={bike.name}
                class="relative z-10 max-h-44 w-auto object-contain transition-transform duration-500 group-hover:scale-108 [filter:drop-shadow(0_0_8px_rgba(255,255,255,0.95))_drop-shadow(0_10px_12px_rgba(0,0,0,0.35))]"
                loading="lazy"
              />
            </div>

            <div class="pt-2 border-t border-gray-200/80">
              <h3 class="text-xl font-black text-gray-900 uppercase font-['Teko',sans-serif] tracking-wide group-hover:text-red-600 transition-colors">
                {bike.name}
              </h3>

              <div class="flex items-center justify-between text-xs text-gray-600 font-semibold my-2">
                <span class="flex items-center gap-1">
                  <svg class="w-3.5 h-3.5 text-gray-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  {bike.categoryLabel}
                </span>
                <span class="flex items-center gap-1">
                  <svg class="w-3.5 h-3.5 text-gray-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  {bike.cc}
                </span>
              </div>

              <div class="mt-3 flex items-center justify-between pt-2 border-t border-gray-200/60">
                <div>
                  <span class="text-[10px] uppercase font-bold text-gray-400 block leading-tight">Desde</span>
                  <span class="text-lg font-black text-gray-900 font-['Teko',sans-serif]">{bike.priceFromPen}</span>
                </div>
                <a
                  href={`/modelos/${bike.slug}`}
                  class="px-3.5 py-1.5 text-xs font-bold uppercase tracking-wider text-gray-900 group-hover:text-white bg-white group-hover:bg-red-600 border border-gray-300 group-hover:border-red-600 rounded-full transition-all"
                >
                  Ver Ficha
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-12 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-red-600"></span>
        <span class="w-2 h-2 rounded-full bg-gray-400"></span>
        <span class="w-2 h-2 rounded-full bg-gray-400"></span>
        <span class="w-2 h-2 rounded-full bg-gray-400"></span>
        <span class="w-2 h-2 rounded-full bg-gray-400"></span>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/modelos"
          class="text-xs font-bold uppercase tracking-wider text-gray-600 hover:text-black mr-2 hidden sm:inline-block"
        >
          Ver todo el catálogo →
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const filterBtns = document.querySelectorAll('.category-filter-btn');
  const ccBtns = document.querySelectorAll('.carousel-cc-btn');
  const sortSelect = document.getElementById('home-sort') as HTMLSelectElement | null;
  const container = document.getElementById('bike-cards-container');
  const cards = Array.from(document.querySelectorAll('.bike-card')) as HTMLElement[];

  let currentCat = 'todas';
  let currentCc = 'all';
  let currentSort = 'default';

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      currentCat = btn.getAttribute('data-category') || 'todas';
      updateCarouselUI();
    });
  });

  ccBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      currentCc = btn.getAttribute('data-cc') || 'all';
      updateCarouselUI();
    });
  });

  if (sortSelect) {
    sortSelect.addEventListener('change', () => {
      currentSort = sortSelect.value;
      updateCarouselUI();
    });
  }

  function updateCarouselUI() {
    // Determine available CCs for the currently selected category
    const availableCcs = new Set<string>();
    cards.forEach((card) => {
      const cat = card.getAttribute('data-category');
      const cc = card.getAttribute('data-cc');
      if (currentCat === 'todas' || cat === currentCat) {
        if (cc) availableCcs.add(cc);
      }
    });

    // If the currently selected CC is no longer available in this category, reset to 'all'
    if (currentCc !== 'all' && !availableCcs.has(currentCc)) {
      currentCc = 'all';
    }

    // Show or hide CC pills dynamically based on existence in selected category
    ccBtns.forEach((b) => {
      const btnCc = b.getAttribute('data-cc') || 'all';
      if (btnCc === 'all') {
        (b as HTMLElement).style.display = 'inline-block';
      } else if (availableCcs.has(btnCc)) {
        (b as HTMLElement).style.display = 'inline-block';
      } else {
        (b as HTMLElement).style.display = 'none';
      }
    });

    filterBtns.forEach((b) => {
      if (b.getAttribute('data-category') === currentCat) {
        b.classList.add('bg-[#0f1118]', 'text-white', 'border-[#0f1118]', 'shadow-md', 'active-category');
        b.classList.remove('bg-white', 'text-gray-600', 'border-gray-200/80');
      } else {
        b.classList.remove('bg-[#0f1118]', 'text-white', 'border-[#0f1118]', 'shadow-md', 'active-category');
        b.classList.add('bg-white', 'text-gray-600', 'border-gray-200/80');
      }
    });

    ccBtns.forEach((b) => {
      if (b.getAttribute('data-cc') === currentCc) {
        b.classList.add('bg-gray-900', 'text-white');
        b.classList.remove('bg-gray-100', 'text-gray-600');
      } else {
        b.classList.remove('bg-gray-900', 'text-white');
        b.classList.add('bg-gray-100', 'text-gray-600');
      }
    });

    const sortedCards = [...cards].sort((a, b) => {
      const priceA = parseInt(a.getAttribute('data-price') || '0', 10);
      const priceB = parseInt(b.getAttribute('data-price') || '0', 10);
      const ccA = parseInt(a.getAttribute('data-cc') || '0', 10);
      const ccB = parseInt(b.getAttribute('data-cc') || '0', 10);
      const idxA = parseInt(a.getAttribute('data-original-index') || '0', 10);
      const idxB = parseInt(b.getAttribute('data-original-index') || '0', 10);

      if (currentSort === 'price-asc') {
        return priceA - priceB;
      } else if (currentSort === 'price-desc') {
        return priceB - priceA;
      } else if (currentSort === 'cc-desc') {
        return ccB - ccA || priceB - priceA;
      } else if (currentSort === 'cc-asc') {
        return ccA - ccB || priceA - priceB;
      } else {
        return idxA - idxB;
      }
    });

    sortedCards.forEach((card) => {
      const cardCat = card.getAttribute('data-category');
      const cardCc = card.getAttribute('data-cc');

      const matchesCat = currentCat === 'todas' || cardCat === currentCat;
      const matchesCc = currentCc === 'all' || cardCc === currentCc;

      if (matchesCat && matchesCc) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }

      if (container) {
        container.appendChild(card);
      }
    });
  }
</script>
