---
import bikes from '../data/bikes.json';

const categories = [
  { id: 'todas', label: 'Todas', count: bikes.length },
  { id: 'pisteras', label: 'Pisteras', count: bikes.filter((b) => b.category === 'pisteras').length },
  { id: 'deportivas', label: 'Deportivas', count: bikes.filter((b) => b.category === 'deportivas').length },
  { id: 'scooter', label: 'Scooters', count: bikes.filter((b) => b.category === 'scooter').length },
  { id: 'todoterreno', label: 'Todoterreno', count: bikes.filter((b) => b.category === 'todoterreno').length },
  { id: 'caferacer', label: 'Cafe Racer', count: bikes.filter((b) => b.category === 'caferacer').length }
];
---

<section class="py-10 md:py-20 bg-[#fafafa] text-gray-900 border-t border-gray-200" id="catalogo-selector">
  <div class="max-w-7xl mx-auto px-6">
    <div class="mb-5 md:mb-6">
      <span class="text-xs font-bold text-gray-500 uppercase tracking-widest font-['Teko',sans-serif] text-base">
        GAMA POR CATEGORÍA
      </span>
      <h2 class="text-4xl md:text-6xl font-black text-gray-900 tracking-tight font-['Teko',sans-serif] leading-none mt-0.5">
        EXPLORA NUESTRAS <span class="text-[#FF0000]">CATEGORÍAS</span>
      </h2>
      <p class="text-xs sm:text-sm text-gray-500 font-medium mt-1">
        Conoce una muestra de cada estilo o visita el catálogo completo.
      </p>
    </div>

    <!-- Category Tabs Navigation Bar with dedicated row and subtle scroll cues -->
    <div class="relative mb-6 md:mb-8">
      <!-- Left scroll button (shown on overflow) -->
      <button
        id="cat-scroll-left"
        type="button"
        class="hidden sm:flex absolute -left-3.5 top-1/2 -translate-y-1/2 z-20 w-8 h-8 rounded-full bg-white border border-gray-300 shadow-md text-gray-800 hover:text-black hover:border-black items-center justify-center transition-all opacity-0 pointer-events-none cursor-pointer"
        aria-label="Ver categorías anteriores"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <!-- Category Buttons Container -->
      <div
        class="flex items-center gap-2 overflow-x-auto pb-2 sm:pb-0 scrollbar-none scroll-smooth touch-pan-x"
        id="category-tabs"
      >
        {categories.map((cat, i) => (
          <button
            class={`category-filter-btn inline-flex items-center gap-2 px-4 py-2 md:px-5 md:py-2.5 rounded-full text-xs md:text-sm font-bold tracking-wider uppercase border transition-all duration-200 whitespace-nowrap cursor-pointer shrink-0 active:scale-95 ${
              i === 0
                ? 'bg-[#0f1118] text-white border-[#0f1118] shadow-md active-category'
                : 'bg-white text-gray-700 hover:text-black hover:bg-gray-100 border-gray-200 shadow-sm'
            }`}
            data-category={cat.id}
          >
            <span>{cat.label}</span>
            <span class={`cat-badge text-[11px] font-black px-2 py-0.5 rounded-full transition-colors ${
              i === 0 ? 'bg-white/20 text-white' : 'bg-gray-100 text-gray-700'
            }`}>
              {cat.count}
            </span>
          </button>
        ))}
      </div>

      <!-- Right scroll button (shown on overflow) -->
      <button
        id="cat-scroll-right"
        type="button"
        class="hidden sm:flex absolute -right-3.5 top-1/2 -translate-y-1/2 z-20 w-8 h-8 rounded-full bg-white border border-gray-300 shadow-md text-gray-800 hover:text-black hover:border-black items-center justify-center transition-all opacity-0 pointer-events-none cursor-pointer"
        aria-label="Ver más categorías"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      <!-- Subtle right fade mask to softly cue horizontal scroll when overflowing -->
      <div
        id="cat-scroll-fade-right"
        class="absolute right-0 top-0 bottom-0 w-16 bg-gradient-to-l from-[#fafafa] via-[#fafafa]/80 to-transparent pointer-events-none transition-opacity duration-300 opacity-0"
      ></div>
      <!-- Subtle left fade mask -->
      <div
        id="cat-scroll-fade-left"
        class="absolute left-0 top-0 bottom-0 w-16 bg-gradient-to-r from-[#fafafa] via-[#fafafa]/80 to-transparent pointer-events-none transition-opacity duration-300 opacity-0"
      ></div>
    </div>

    <div class="relative">
      <div
        id="bike-cards-container"
        class="flex overflow-x-auto pb-6 pt-2 gap-4 snap-x snap-mandatory sm:grid sm:grid-cols-2 lg:grid-cols-4 sm:gap-6 sm:pb-0 sm:pt-0 scrollbar-none transition-all duration-300"
      >
        {bikes.map((bike, index) => (
          <div
            class="bike-card group bg-[#f3f4f6] hover:bg-white rounded-2xl p-5 border border-transparent hover:border-gray-200 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between w-[84vw] max-w-[320px] shrink-0 snap-center sm:w-auto sm:max-w-none sm:shrink"
            data-category={bike.category}
            data-cc={parseInt(bike.cc.replace('cc', '').trim())}
            data-price={bike.rawPricePen}
            data-original-index={index}
          >
            <button
              type="button"
              class="bike-image-box relative w-full h-52 flex items-center justify-center p-2 mb-4 rounded-xl overflow-hidden bg-gray-200 cursor-zoom-in group/img text-left focus:outline-none focus:ring-2 focus:ring-red-500"
              data-lightbox-name={bike.name}
              data-lightbox-image={bike.transparentImage}
              data-lightbox-bg={`/images/categories/bg-${bike.category}.jpg`}
              data-lightbox-cat={bike.categoryLabel}
              data-lightbox-cc={bike.cc}
              data-lightbox-price={bike.priceFromPen}
              data-lightbox-slug={bike.slug}
              title={`Click para ver ${bike.name} en grande`}
              aria-label={`Ver ${bike.name} en grande`}
            >
              <img
                src={`/images/categories/bg-${bike.category}.jpg`}
                alt=""
                aria-hidden="true"
                class="absolute inset-0 w-full h-full object-cover object-center opacity-80 brightness-110 transition-transform duration-700 group-hover/img:scale-105"
                loading="lazy"
              />
              <!-- Bright central spotlight so dark/red bikes never blend into the background -->
              <div class="absolute inset-0 bg-[radial-gradient(ellipse_75%_70%_at_50%_55%,rgba(255,255,255,0.92)_0%,rgba(255,255,255,0.72)_45%,rgba(255,255,255,0.22)_80%,transparent_100%)] pointer-events-none"></div>
              <!-- Ground shadow under wheels -->
              <div class="absolute bottom-3 left-1/2 -translate-x-1/2 w-2/3 h-3 bg-black/30 blur-md rounded-full pointer-events-none"></div>

              <!-- Subtle zoom icon badge in top right -->
              <div class="absolute top-2.5 right-2.5 z-20 w-8 h-8 rounded-full bg-black/60 text-white flex items-center justify-center opacity-70 group-hover/img:opacity-100 group-hover/img:scale-110 transition-all duration-200 shadow-md backdrop-blur-sm pointer-events-none">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7" />
                </svg>
              </div>

              <img
                src={bike.transparentImage}
                alt={bike.name}
                class="relative z-10 max-h-44 w-auto object-contain transition-transform duration-500 group-hover/img:scale-108 [filter:drop-shadow(0_0_8px_rgba(255,255,255,0.95))_drop-shadow(0_10px_12px_rgba(0,0,0,0.35))]"
                loading="lazy"
              />
            </button>

            <div class="pt-2 border-t border-gray-200/80">
              <h3 class="text-xl font-black text-gray-900 uppercase font-['Teko',sans-serif] tracking-wide group-hover:text-red-600 transition-colors">
                {bike.name}
              </h3>

              <div class="flex items-center justify-between text-xs text-gray-600 font-semibold my-2">
                <span class="flex items-center gap-1">
                  <svg class="w-3.5 h-3.5 text-gray-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  {bike.categoryLabel}
                </span>
                <span class="flex items-center gap-1">
                  <svg class="w-3.5 h-3.5 text-gray-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  {bike.cc}
                </span>
              </div>

              <div class="mt-3 flex items-center justify-between pt-2 border-t border-gray-200/60">
                <div>
                  <span class="text-[10px] uppercase font-bold text-gray-400 block leading-tight">Desde</span>
                  <span class="text-lg font-black text-gray-900 font-['Teko',sans-serif]">{bike.priceFromPen}</span>
                </div>
                <a
                  href={`/modelos/${bike.slug}`}
                  class="inline-flex items-center gap-1.5 px-4 py-2 text-xs font-black uppercase tracking-wider text-white bg-[#FF0000] hover:bg-black rounded-full shadow-md shadow-red-600/25 hover:shadow-lg transition-all active:scale-95 group/btn cursor-pointer"
                >
                  <span>Ver Ficha</span>
                  <svg class="w-3.5 h-3.5 transform group-hover/btn:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Dynamic CTA Card linking to full catalog -->
    <div class="mt-6 md:mt-8 bg-white border border-gray-200 rounded-2xl p-5 sm:p-6 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="text-center sm:text-left">
        <h4 class="text-xl md:text-2xl font-black uppercase text-gray-900 font-['Teko',sans-serif] tracking-wide leading-none" id="catalog-cta-title">
          ¿Buscas ver todas las opciones disponibles?
        </h4>
        <p class="text-xs md:text-sm text-gray-500 font-medium mt-1" id="catalog-cta-sub">
          Explora los 26 modelos con filtros por cilindrada y fichas técnicas completas.
        </p>
      </div>
      <a
        id="catalog-cta-link"
        href="/modelos"
        class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full text-xs font-black uppercase tracking-wider text-white bg-gray-900 hover:bg-[#FF0000] shadow-md transition-all whitespace-nowrap cursor-pointer active:scale-95 group w-full sm:w-auto"
      >
        <span id="catalog-cta-btn-text">Ver Catálogo Completo (26 Modelos)</span>
        <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>

  <!-- Lightbox Modal for Large Bike View with Blurred Home Background -->
  <div
    id="bike-lightbox"
    class="fixed inset-0 z-[100] flex items-center justify-center p-3 sm:p-6 opacity-0 pointer-events-none transition-all duration-300"
    role="dialog"
    aria-modal="true"
    aria-label="Vista detallada de motocicleta"
  >
    <!-- Dark blurred backdrop -->
    <div
      id="lightbox-backdrop"
      class="fixed inset-0 bg-black/85 backdrop-blur-md transition-opacity duration-300 cursor-pointer"
    ></div>

    <!-- Modal Content Window -->
    <div
      id="lightbox-dialog"
      class="relative z-10 w-full max-w-4xl bg-gradient-to-b from-[#181a20] via-[#101216] to-[#0a0b0e] border border-white/20 rounded-3xl p-5 sm:p-7 shadow-2xl overflow-hidden transform scale-95 transition-all duration-300 flex flex-col justify-between"
    >
      <!-- Top Bar: Category badge, title & Close button -->
      <div class="flex items-start justify-between gap-4 mb-3 sm:mb-4">
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span
              id="lightbox-badge-cat"
              class="text-[10px] font-black uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-white/10 text-white border border-white/20"
            >
              Categoría
            </span>
            <span
              id="lightbox-badge-cc"
              class="text-[10px] font-black uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-red-600/20 text-red-400 border border-red-500/30"
            >
              Cilindrada
            </span>
          </div>
          <h3
            id="lightbox-title"
            class="text-2xl sm:text-4xl md:text-5xl font-black uppercase text-white font-['Teko',sans-serif] tracking-wide leading-none"
          >
            NOMBRE DE LA MOTO
          </h3>
        </div>

        <!-- Close Button -->
        <button
          id="lightbox-close"
          type="button"
          class="w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-white/15 hover:bg-white text-white hover:text-black border border-white/20 hover:border-white flex items-center justify-center transition-all cursor-pointer shrink-0 shadow-lg active:scale-95"
          aria-label="Cerrar vista grande"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Main Large Bike Stage -->
      <div class="relative w-full h-[280px] sm:h-[380px] md:h-[460px] rounded-2xl overflow-hidden flex items-center justify-center p-4 bg-black/50 border border-white/10">
        <!-- Background scene -->
        <img
          id="lightbox-bg"
          src=""
          alt=""
          aria-hidden="true"
          class="absolute inset-0 w-full h-full object-cover object-center opacity-35 brightness-90 filter blur-[1px]"
        />
        <!-- Spotlight halo -->
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_75%_at_50%_55%,rgba(255,255,255,0.3)_0%,rgba(255,255,255,0.08)_50%,transparent_75%)] pointer-events-none"></div>
        <!-- Shadow under tires -->
        <div class="absolute bottom-6 left-1/2 -translate-x-1/2 w-3/4 h-6 bg-black/70 blur-xl rounded-full pointer-events-none"></div>

        <!-- Large Bike Cutout Image -->
        <img
          id="lightbox-img"
          src=""
          alt=""
          class="relative z-10 max-h-[240px] sm:max-h-[340px] md:max-h-[420px] w-auto object-contain transition-transform duration-500 [filter:drop-shadow(0_15px_30px_rgba(0,0,0,0.85))_drop-shadow(0_0_15px_rgba(255,255,255,0.45))]"
        />
      </div>

      <!-- Bottom Footer: Price & Direct Actions -->
      <div class="mt-4 sm:mt-5 pt-4 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="text-center sm:text-left">
          <span class="text-[10px] sm:text-xs uppercase font-bold text-gray-400 block tracking-wider leading-tight">
            PRECIO AL CONTADO
          </span>
          <span
            id="lightbox-price"
            class="text-2xl sm:text-4xl font-black text-white font-['Teko',sans-serif] tracking-tight leading-none"
          >
            S/ 0*
          </span>
        </div>

        <div class="flex items-center gap-3 w-full sm:w-auto">
          <a
            id="lightbox-link-detail"
            href="/modelos"
            class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full text-xs font-black uppercase tracking-wider text-white bg-[#FF0000] hover:bg-white hover:text-black shadow-lg shadow-red-600/30 transition-all cursor-pointer active:scale-95"
          >
            <span>Ver Ficha Técnica Completa</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <a
            id="lightbox-link-whatsapp"
            href="https://wa.me/51981234567"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full text-xs font-black uppercase tracking-wider text-white bg-emerald-600 hover:bg-emerald-700 shadow-lg shadow-emerald-600/30 transition-all cursor-pointer active:scale-95"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z" />
            </svg>
            <span class="hidden sm:inline">WhatsApp</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ categoriesData: categories }}>
  const filterBtns = document.querySelectorAll('.category-filter-btn');
  const container = document.getElementById('bike-cards-container');
  const cards = Array.from(document.querySelectorAll('.bike-card'));
  const ctaTitle = document.getElementById('catalog-cta-title');
  const ctaSub = document.getElementById('catalog-cta-sub');
  const ctaLink = document.getElementById('catalog-cta-link');
  const ctaBtnText = document.getElementById('catalog-cta-btn-text');

  // Category Tabs Scroll elements
  const catTabs = document.getElementById('category-tabs');
  const scrollLeftBtn = document.getElementById('cat-scroll-left');
  const scrollRightBtn = document.getElementById('cat-scroll-right');
  const fadeLeft = document.getElementById('cat-scroll-fade-left');
  const fadeRight = document.getElementById('cat-scroll-fade-right');

  let currentCat = 'todas';

  function updateCategoryScrollCues() {
    if (!catTabs) return;
    const scrollLeft = catTabs.scrollLeft;
    const maxScroll = catTabs.scrollWidth - catTabs.clientWidth;
    const hasOverflow = maxScroll > 8;

    const canScrollLeft = hasOverflow && scrollLeft > 10;
    const canScrollRight = hasOverflow && scrollLeft < maxScroll - 10;

    if (scrollLeftBtn) {
      if (canScrollLeft) {
        scrollLeftBtn.classList.remove('opacity-0', 'pointer-events-none');
        scrollLeftBtn.classList.add('opacity-100');
      } else {
        scrollLeftBtn.classList.add('opacity-0', 'pointer-events-none');
        scrollLeftBtn.classList.remove('opacity-100');
      }
    }

    if (scrollRightBtn) {
      if (canScrollRight) {
        scrollRightBtn.classList.remove('opacity-0', 'pointer-events-none');
        scrollRightBtn.classList.add('opacity-100');
      } else {
        scrollRightBtn.classList.add('opacity-0', 'pointer-events-none');
        scrollRightBtn.classList.remove('opacity-100');
      }
    }

    if (fadeLeft) fadeLeft.style.opacity = canScrollLeft ? '1' : '0';
    if (fadeRight) fadeRight.style.opacity = canScrollRight ? '1' : '0';
  }

  catTabs?.addEventListener('scroll', updateCategoryScrollCues, { passive: true });
  window.addEventListener('resize', updateCategoryScrollCues);

  scrollLeftBtn?.addEventListener('click', () => {
    catTabs?.scrollBy({ left: -240, behavior: 'smooth' });
  });

  scrollRightBtn?.addEventListener('click', () => {
    catTabs?.scrollBy({ left: 240, behavior: 'smooth' });
  });

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      currentCat = btn.getAttribute('data-category') || 'todas';
      updateCarouselUI();
      // Smoothly bring clicked button into view if partially hidden
      btn.scrollIntoView({ behavior: 'smooth', inline: 'nearest', block: 'nearest' });
    });
  });

  function updateCarouselUI() {
    // 1. Update filter buttons styling
    filterBtns.forEach((b) => {
      const badge = b.querySelector('.cat-badge');
      if (b.getAttribute('data-category') === currentCat) {
        b.classList.add('bg-[#0f1118]', 'text-white', 'border-[#0f1118]', 'shadow-md', 'active-category');
        b.classList.remove('bg-white', 'text-gray-700', 'border-gray-200');
        if (badge) {
          badge.classList.add('bg-white/20', 'text-white');
          badge.classList.remove('bg-gray-100', 'text-gray-700');
        }
      } else {
        b.classList.remove('bg-[#0f1118]', 'text-white', 'border-[#0f1118]', 'shadow-md', 'active-category');
        b.classList.add('bg-white', 'text-gray-700', 'border-gray-200');
        if (badge) {
          badge.classList.remove('bg-white/20', 'text-white');
          badge.classList.add('bg-gray-100', 'text-gray-700');
        }
      }
    });

    // 2. Select up to 4 models to display
    if (currentCat === 'todas') {
      // Pick 1 from each major family: pisteras, deportivas, todoterreno, scooter
      const priorityOrder = ['pisteras', 'deportivas', 'todoterreno', 'scooter', 'caferacer'];
      const pickedCards = new Set();

      for (const cat of priorityOrder) {
        if (pickedCards.size >= 4) break;
        const match = cards.find((c) => c.getAttribute('data-category') === cat && !pickedCards.has(c));
        if (match) pickedCards.add(match);
      }
      for (const card of cards) {
        if (pickedCards.size >= 4) break;
        pickedCards.add(card);
      }

      cards.forEach((card) => {
        if (pickedCards.has(card)) {
          card.style.display = 'flex';
          if (container) container.appendChild(card);
        } else {
          card.style.display = 'none';
        }
      });
    } else {
      let count = 0;
      cards.forEach((card) => {
        const cardCat = card.getAttribute('data-category');
        if (cardCat === currentCat && count < 4) {
          card.style.display = 'flex';
          count++;
          if (container) container.appendChild(card);
        } else {
          card.style.display = 'none';
        }
      });
    }

    // 3. Update dynamic CTA card
    const activeCategoryObj = categoriesData.find((c) => c.id === currentCat);
    const catLabel = activeCategoryObj ? activeCategoryObj.label : '';
    const catCount = activeCategoryObj ? activeCategoryObj.count : 26;

    if (currentCat === 'todas') {
      if (ctaTitle) ctaTitle.textContent = '¿Buscas ver todas las opciones disponibles?';
      if (ctaSub) ctaSub.textContent = 'Explora los 26 modelos con filtros por cilindrada y fichas técnicas completas.';
      if (ctaLink) ctaLink.href = '/modelos';
      if (ctaBtnText) ctaBtnText.textContent = 'Ver Catálogo Completo (26 Modelos)';
    } else {
      if (ctaTitle) ctaTitle.textContent = `¿Buscas más modelos de ${catLabel}?`;
      if (ctaSub) ctaSub.textContent = `Tenemos ${catCount} modelos en esta categoría con fichas técnicas y opciones de financiamiento.`;
      if (ctaLink) ctaLink.href = `/modelos?cat=${currentCat}`;
      if (ctaBtnText) ctaBtnText.textContent = `Ver todas las ${catLabel} (${catCount} Modelos)`;
    }

    // Reset horizontal scroll
    if (container) {
      container.scrollLeft = 0;
    }
  }

  // --- Lightbox Modal Logic ---
  const lightbox = document.getElementById('bike-lightbox');
  const lightboxBackdrop = document.getElementById('lightbox-backdrop');
  const lightboxDialog = document.getElementById('lightbox-dialog');
  const lightboxClose = document.getElementById('lightbox-close');
  const lightboxImg = document.getElementById('lightbox-img');
  const lightboxBg = document.getElementById('lightbox-bg');
  const lightboxTitle = document.getElementById('lightbox-title');
  const lightboxBadgeCat = document.getElementById('lightbox-badge-cat');
  const lightboxBadgeCc = document.getElementById('lightbox-badge-cc');
  const lightboxPrice = document.getElementById('lightbox-price');
  const lightboxLinkDetail = document.getElementById('lightbox-link-detail');
  const lightboxLinkWa = document.getElementById('lightbox-link-whatsapp');

  function openLightbox(btn) {
    if (!lightbox) return;
    const name = btn.getAttribute('data-lightbox-name') || '';
    const img = btn.getAttribute('data-lightbox-image') || '';
    const bg = btn.getAttribute('data-lightbox-bg') || '';
    const cat = btn.getAttribute('data-lightbox-cat') || '';
    const cc = btn.getAttribute('data-lightbox-cc') || '';
    const price = btn.getAttribute('data-lightbox-price') || '';
    const slug = btn.getAttribute('data-lightbox-slug') || '';

    if (lightboxTitle) lightboxTitle.textContent = name;
    if (lightboxBadgeCat) lightboxBadgeCat.textContent = cat;
    if (lightboxBadgeCc) lightboxBadgeCc.textContent = cc;
    if (lightboxPrice) lightboxPrice.textContent = price;
    if (lightboxImg) {
      lightboxImg.src = img;
      lightboxImg.alt = name;
    }
    if (lightboxBg) {
      lightboxBg.src = bg;
    }
    if (lightboxLinkDetail) {
      lightboxLinkDetail.href = `/modelos/${slug}`;
    }
    if (lightboxLinkWa) {
      const waMsg = encodeURIComponent(`¡Hola Nexus! Vengo de la web y me interesa cotizar la motocicleta ${name} (${price}). ¿Podrían darme más información?`);
      lightboxLinkWa.href = `https://wa.me/51981234567?text=${waMsg}`;
    }

    // Reveal lightbox modal with zoom & blur transition
    lightbox.classList.remove('opacity-0', 'pointer-events-none');
    lightbox.classList.add('opacity-100');
    if (lightboxDialog) {
      lightboxDialog.classList.remove('scale-95');
      lightboxDialog.classList.add('scale-100');
    }
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    if (!lightbox) return;
    lightbox.classList.add('opacity-0', 'pointer-events-none');
    lightbox.classList.remove('opacity-100');
    if (lightboxDialog) {
      lightboxDialog.classList.remove('scale-100');
      lightboxDialog.classList.add('scale-95');
    }
    document.body.style.overflow = '';
  }

  // Bind click on all bike image boxes
  document.querySelectorAll('.bike-image-box').forEach((box) => {
    box.addEventListener('click', (e) => {
      e.stopPropagation();
      openLightbox(box);
    });
  });

  lightboxClose?.addEventListener('click', closeLightbox);
  lightboxBackdrop?.addEventListener('click', closeLightbox);
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && lightbox && !lightbox.classList.contains('opacity-0')) {
      closeLightbox();
    }
  });

  // Initial call on page load
  updateCarouselUI();
  setTimeout(updateCategoryScrollCues, 100);
</script>
