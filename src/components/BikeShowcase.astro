---
import bikes from '../data/bikes.json';
import site from '../data/site.json';

function cleanTransmission(trans: string): string {
  const t = (trans || '').toLowerCase();
  if (t.includes('auto') && !t.includes('semi')) return 'Automática';
  if (t.includes('semi')) return 'Semiautomática';
  return 'Manual';
}

function cleanPower(power: string): string {
  // e.g. "22.0 HP / 8500 rpm" -> "22 HP"
  const hpPart = (power || '').split('/')[0].trim();
  return hpPart.replace('.0', '');
}

const showcaseBikes = bikes
  .filter((b) => b.showcase)
  .map((b) => ({
    ...b,
    displayPower: cleanPower(b.power),
    displayTrans: cleanTransmission(b.transmission)
  }));
---

<section class="py-20 bg-[#fafafa] text-gray-900 overflow-hidden relative border-t border-gray-200" id="showcase-section">
  <div class="absolute inset-0 bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] [background-size:24px_24px] opacity-70"></div>

  <div class="max-w-7xl mx-auto px-6 relative z-10">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-8">
      <div>
        <span class="text-xs font-bold text-gray-500 uppercase tracking-widest font-['Teko',sans-serif] text-base">
          VITRINA PRINCIPAL
        </span>
        <h2 class="text-5xl md:text-7xl font-black uppercase text-gray-900 leading-[0.9] tracking-tight font-['Teko',sans-serif]">
          SIENTE EL LLAMADO DE TU NUEVA <span class="text-[#FF0000]">NEXUS</span>
        </h2>
      </div>
      <p class="text-gray-500 text-sm max-w-md font-medium">
        Explora las especificaciones clave de los modelos insignia con respaldo oficial de Grupo Lauzher.
      </p>
    </div>

    <!-- Bike Stage with Navigation Arrows -->
    <div class="relative min-h-[380px] md:min-h-[460px] flex items-center justify-center">
      <!-- Floating Navigation Arrow Prev -->
      <button
        id="stage-prev"
        class="absolute left-0 md:left-4 z-30 w-12 h-12 md:w-14 md:h-14 rounded-full bg-white/90 backdrop-blur-sm border border-gray-200 shadow-md hover:shadow-lg hover:border-black flex items-center justify-center text-gray-800 hover:text-black hover:scale-105 transition-all cursor-pointer"
        aria-label="Modelo anterior"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <!-- Center Bike Display -->
      <div class="relative w-full max-w-3xl flex items-center justify-center py-4">
        <img
          id="showcase-bike-img"
          src={showcaseBikes[0].transparentImage}
          alt={showcaseBikes[0].name}
          class="w-full max-w-[580px] md:max-w-[640px] h-auto object-contain drop-shadow-[0_25px_30px_rgba(0,0,0,0.25)] transition-all duration-500 transform hover:scale-105"
        />
        <div class="absolute -bottom-2 w-3/4 h-8 bg-black/15 rounded-[100%] blur-md -z-10"></div>
      </div>

      <!-- Floating Navigation Arrow Next -->
      <button
        id="stage-next"
        class="absolute right-0 md:right-4 z-30 w-12 h-12 md:w-14 md:h-14 rounded-full bg-white/90 backdrop-blur-sm border border-gray-200 shadow-md hover:shadow-lg hover:border-black flex items-center justify-center text-gray-800 hover:text-black hover:scale-105 transition-all cursor-pointer"
        aria-label="Siguiente modelo"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>

    <!-- Spacious Specs & Model Info Card -->
    <div class="mt-4 max-w-4xl mx-auto bg-white border border-gray-200 rounded-3xl p-6 md:p-8 shadow-xl">
      <!-- Header Row: Model Name & Price -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-gray-100">
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span id="badge-cat" class="text-xs uppercase font-bold text-gray-500 tracking-wider">
              {showcaseBikes[0].categoryLabel}
            </span>
          </div>
          <h3 id="spec-name" class="text-4xl md:text-6xl font-black uppercase text-gray-900 font-['Teko',sans-serif] tracking-tight leading-none">
            {showcaseBikes[0].name}
          </h3>
        </div>

        <div class="text-left sm:text-right flex-shrink-0">
          <span class="text-[10px] uppercase font-bold text-gray-400 block tracking-wider">Precio Sugerido</span>
          <span id="spec-price" class="text-3xl md:text-5xl font-black text-gray-900 font-['Teko',sans-serif] tracking-tight block leading-none">
            {showcaseBikes[0].priceFromPen}
          </span>
          <span id="spec-installments" class="text-xs font-bold text-emerald-600 block mt-0.5">
            Cuotas desde {showcaseBikes[0].installmentsFrom}
          </span>
        </div>
      </div>

      <!-- 3 Key Specs Cards: Cilindrada, Potencia, Transmision -->
      <div class="grid grid-cols-3 gap-3 md:gap-5 py-6">
        <!-- Cilindrada -->
        <div class="bg-gray-50 border border-gray-200/90 rounded-2xl p-4 text-center hover:bg-gray-100/70 transition-colors">
          <span class="text-[10px] uppercase font-bold text-gray-500 block tracking-wider mb-1">
            Cilindrada
          </span>
          <span id="spec-cc" class="text-2xl md:text-4xl font-black text-gray-900 font-['Teko',sans-serif] tracking-tight block">
            {showcaseBikes[0].cc}
          </span>
        </div>

        <!-- Potencia (solo número y HP) -->
        <div class="bg-gray-50 border border-gray-200/90 rounded-2xl p-4 text-center hover:bg-gray-100/70 transition-colors">
          <span class="text-[10px] uppercase font-bold text-gray-500 block tracking-wider mb-1">
            Potencia
          </span>
          <span id="spec-power" class="text-2xl md:text-4xl font-black text-gray-900 font-['Teko',sans-serif] tracking-tight block">
            {showcaseBikes[0].displayPower}
          </span>
        </div>

        <!-- Transmisión (Manual / Automática / Semiautomática) -->
        <div class="bg-gray-50 border border-gray-200/90 rounded-2xl p-4 text-center hover:bg-gray-100/70 transition-colors">
          <span class="text-[10px] uppercase font-bold text-gray-500 block tracking-wider mb-1">
            Transmisión
          </span>
          <span id="spec-trans" class="text-2xl md:text-4xl font-black text-gray-900 font-['Teko',sans-serif] tracking-tight block truncate">
            {showcaseBikes[0].displayTrans}
          </span>
        </div>
      </div>

      <!-- Footer Row: Counter & Action CTAs -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-4 border-t border-gray-100">
        <!-- Counter and selector dots -->
        <div class="flex items-center gap-2">
          <span class="text-xs font-bold text-gray-500 uppercase tracking-wider" id="showcase-counter">
            1 de {showcaseBikes.length} modelos destacados
          </span>
        </div>

        <!-- CTA Buttons -->
        <div class="flex items-center gap-3 w-full sm:w-auto">
          <a
            id="showcase-detail-btn"
            href={`/modelos/${showcaseBikes[0].slug}`}
            class="flex-1 sm:flex-initial text-center px-6 py-3 text-xs font-bold uppercase tracking-wider text-gray-800 bg-white border border-gray-300 hover:border-black hover:text-black rounded-full transition-all"
          >
            Ficha Técnica
          </a>
          <a
            id="showcase-quote-btn"
            href={`https://wa.me/${site.whatsappNumber}?text=Hola%20Grupo%20Lauzher,%20deseo%20cotizar%20la%20moto%20${encodeURIComponent(showcaseBikes[0].name)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 sm:flex-initial text-center px-6 py-3 text-xs font-black uppercase tracking-wider text-white bg-emerald-600 hover:bg-emerald-700 rounded-full shadow-md shadow-emerald-600/20 transition-all flex items-center justify-center gap-1.5"
          >
            Cotizar por WhatsApp
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ showcaseBikes, whatsappNumber: site.whatsappNumber }}>
  let currentIndex = 0;
  const total = showcaseBikes.length;

  const imgEl = document.getElementById('showcase-bike-img');
  const badgeTag = document.getElementById('badge-tag');
  const badgeCat = document.getElementById('badge-cat');
  const specName = document.getElementById('spec-name');
  const specPrice = document.getElementById('spec-price');
  const specInstallments = document.getElementById('spec-installments');
  const specCc = document.getElementById('spec-cc');
  const specPower = document.getElementById('spec-power');
  const specTrans = document.getElementById('spec-trans');
  const counter = document.getElementById('showcase-counter');
  const detailBtn = document.getElementById('showcase-detail-btn');
  const quoteBtn = document.getElementById('showcase-quote-btn');

  function updateShowcase(index) {
    const bike = showcaseBikes[index];

    if (imgEl) {
      imgEl.style.opacity = '0';
      imgEl.style.transform = 'scale(0.95)';

      setTimeout(() => {
        imgEl.src = bike.transparentImage;
        imgEl.alt = bike.name;
        imgEl.style.opacity = '1';
        imgEl.style.transform = 'scale(1)';
      }, 180);
    }

    if (badgeTag) badgeTag.textContent = bike.tag || 'DESTACADO';
    if (badgeCat) badgeCat.textContent = bike.categoryLabel || '';
    if (specName) specName.textContent = bike.name;
    if (specPrice) specPrice.textContent = bike.priceFromPen;
    if (specInstallments) specInstallments.textContent = `Cuotas desde ${bike.installmentsFrom}`;
    if (specCc) specCc.textContent = bike.cc;
    if (specPower) specPower.textContent = bike.displayPower;
    if (specTrans) specTrans.textContent = bike.displayTrans;
    if (counter) counter.textContent = `${index + 1} de ${total} modelos destacados`;
    if (detailBtn) detailBtn.href = `/modelos/${bike.slug}`;
    if (quoteBtn) {
      const modelUrl = `${window.location.origin}/modelos/${bike.slug}`;
      const msg = `Hola Grupo Lauzher, deseo cotizar la moto ${bike.name} (${bike.priceFromPen}).\n\nModelo: ${modelUrl}`;
      quoteBtn.href = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(msg)}`;
    }

    currentIndex = index;
  }

  // Initialize first quote button with full model URL
  if (quoteBtn && showcaseBikes[0]) {
    const modelUrl = `${window.location.origin}/modelos/${showcaseBikes[0].slug}`;
    const msg = `Hola Grupo Lauzher, deseo cotizar la moto ${showcaseBikes[0].name} (${showcaseBikes[0].priceFromPen}).\n\nModelo: ${modelUrl}`;
    quoteBtn.href = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(msg)}`;
  }

  const prevBtn = document.getElementById('stage-prev');
  const nextBtn = document.getElementById('stage-next');

  nextBtn?.addEventListener('click', () => {
    const next = (currentIndex + 1) % total;
    updateShowcase(next);
  });

  prevBtn?.addEventListener('click', () => {
    const prev = (currentIndex - 1 + total) % total;
    updateShowcase(prev);
  });
</script>
