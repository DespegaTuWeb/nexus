---
import site from '../data/site.json';

const slides = [
  {
    tag: "DEPORTIVAS",
    title: "NEXUS 250 RS SPORT",
    headline: "DISEÑADA PARA LOS QUE NO SE DETIENEN",
    description: "Motor 250cc con radiador de aceite, carenado aerodinámico deportivo, tablero 100% digital y frenos de disco lobulados para máxima precisión.",
    price: "S/ 8,738*",
    installments: "Cuotas desde S/ 292/mes*",
    image: "/images/banners/banner-nexus-250-rs-sport.png",
    mobileImage: "/images/banners/banner-movil-nexus-250.webp",
    link: "/modelos/nexus-250-rsport",
    primaryCta: "Ver Ficha Técnica",
    accentColor: "from-red-600/40",
    isGraphicBanner: true
  },
  {
    tag: "LÍDER EN MOVILIDAD URBANA",
    title: "NEXUS SCOOTER 150 TAX",
    headline: "MÁXIMA COMODIDAD, TRANSMISIÓN AUTOMÁTICA CVT",
    description: "La reina de la ciudad: transmisión continua CVT libre de cambios de marcha, amplia maletera, puerto de carga USB y rendimiento superior.",
    price: "S/ 4,869*",
    installments: "Desde S/ 163/mes*",
    image: "/images/banners/banner-carrusel-3.png",
    link: "/modelos/nexus-scooter-150-tax",
    primaryCta: "Conocer Scooter",
    accentColor: "from-blue-600/40",
    isGraphicBanner: false
  },
  {
    tag: "BENEFICIOS POR TU COMPRA",
    title: "BENEFICIOS INCLUIDOS NEXUS",
    headline: "TRÁMITE DE PLACA + CASCO + HERRAMIENTAS + ACEITE",
    description: "Por la compra de tu unidad se incluye trámite de tarjeta y placa (15-20 días), casco, kit de herramientas, aceite de activación y los 03 primeros mantenimientos gratis (mano de obra).",
    price: "Pack Incluido",
    installments: "Garantía 1 año o 12,000KM (Sólo Motor)",
    image: "/images/banners/banner-carrusel-2.png",
    link: "/combos-promociones",
    primaryCta: "Ver Beneficios",
    accentColor: "from-amber-600/40",
    isGraphicBanner: false
  }
];
---

<div class="relative w-full overflow-hidden bg-[#0a0b0e] select-none group" id="hero-slider">
  <div class="relative w-full h-full">
    {slides.map((slide, index) => (
      <div
        class={`hero-slide absolute inset-0 transition-opacity duration-1000 ease-in-out ${index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none'}`}
        data-slide-index={index}
      >
        {slide.isGraphicBanner ? (
          <div class="relative w-full h-full">
            <a href={slide.link} class="block w-full h-full" aria-label={`Ver ficha técnica de ${slide.title}`}>
              <picture class="block w-full h-full">
                {slide.mobileImage && (
                  <source media="(max-width: 639px)" srcset={slide.mobileImage} />
                )}
                <img
                  src={slide.image}
                  alt={slide.title}
                  class="w-full h-full object-cover object-center block"
                />
              </picture>
            </a>
          </div>
        ) : (
          <div class="relative w-full h-full">
            <div class="absolute inset-0">
              <img
                src={slide.image}
                alt={slide.title}
                class="w-full h-full object-cover object-center filter brightness-[0.45] contrast-110 transform scale-105 transition-transform duration-[7000ms] ease-out slide-bg-image"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#0b0d12] via-[#0b0d12]/40 to-black/60"></div>
              <div class={`absolute inset-0 bg-gradient-to-r ${slide.accentColor} via-transparent to-black/80`}></div>
            </div>

            <div class="relative z-20 max-w-7xl mx-auto h-full px-6 flex flex-col justify-center">
              <div class="max-w-2xl space-y-3 sm:space-y-4">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/15 border border-white/30 backdrop-blur-sm">
                  <span class="text-xs font-black tracking-widest text-white uppercase font-['Teko',sans-serif]">
                    {slide.tag}
                  </span>
                </div>

                <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black uppercase text-white tracking-tight leading-[0.9] font-['Teko',sans-serif] drop-shadow-lg">
                  <Fragment set:html={slide.title.replace('NEXUS', '<span class="text-[#FF0000]">NEXUS</span>')} />
                </h1>

                <p class="text-sm sm:text-base md:text-xl font-bold uppercase text-white/90 tracking-wider">
                  {slide.headline}
                </p>

                <p class="text-xs sm:text-sm md:text-base text-gray-300 leading-relaxed font-normal max-w-xl hidden md:block">
                  {slide.description}
                </p>

                <div class="pt-1 sm:pt-2 flex flex-wrap items-baseline gap-4">
                  <div class="flex flex-col">
                    <span class="text-xs uppercase text-gray-400 font-semibold tracking-wider">Precio Sugerido</span>
                    <span class="text-2xl md:text-4xl font-extrabold text-white tracking-tight font-['Teko',sans-serif]">
                      {slide.price}
                    </span>
                  </div>
                  <div class="h-8 w-[1px] bg-gray-700 hidden sm:block"></div>
                  <div class="flex flex-col">
                    <span class="text-xs uppercase text-gray-400 font-semibold tracking-wider">Financiamiento</span>
                    <span class="text-sm md:text-base font-semibold text-emerald-400">
                      {slide.installments}
                    </span>
                  </div>
                </div>

                <div class="pt-2 sm:pt-3 flex flex-wrap items-center gap-3 sm:gap-4">
                  <a
                    href={slide.link}
                    class="px-6 py-2.5 sm:px-7 sm:py-3 text-xs md:text-sm font-bold uppercase tracking-wider text-white bg-gray-900 hover:bg-black border border-white/20 active:scale-95 rounded-full shadow-lg transition-all flex items-center gap-2"
                  >
                    {slide.primaryCta}
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                  </a>
                  <a
                    href={`https://wa.me/${site.whatsappNumber}?text=Hola%20Grupo%20Lauzher,%20deseo%20cotizar%20la%20moto%20${encodeURIComponent(slide.title)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-6 py-2.5 sm:px-7 sm:py-3 text-xs md:text-sm font-bold uppercase tracking-wider text-white bg-emerald-600 hover:bg-emerald-700 rounded-full shadow-lg shadow-emerald-600/30 transition-all flex items-center gap-2"
                  >
                    Cotizar por WhatsApp
                  </a>
                </div>
              </div>
            </div>
          </div>
        )}
      </div>
    ))}
  </div>

  <button
    id="slider-prev"
    class="absolute left-3 sm:left-4 top-1/2 -translate-y-1/2 z-30 w-10 h-10 md:w-12 md:h-12 rounded-full bg-black/50 hover:bg-black/80 border border-white/25 text-white flex items-center justify-center transition-all opacity-80 hover:opacity-100 hover:scale-110 focus:outline-none cursor-pointer"
    aria-label="Anterior slide"
  >
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
    </svg>
  </button>

  <button
    id="slider-next"
    class="absolute right-3 sm:right-4 top-1/2 -translate-y-1/2 z-30 w-10 h-10 md:w-12 md:h-12 rounded-full bg-black/50 hover:bg-black/80 border border-white/25 text-white flex items-center justify-center transition-all opacity-80 hover:opacity-100 hover:scale-110 focus:outline-none cursor-pointer"
    aria-label="Siguiente slide"
  >
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
    </svg>
  </button>

  <div class="absolute bottom-4 sm:bottom-5 left-1/2 -translate-x-1/2 z-30 flex items-center gap-3">
    {slides.map((_, i) => (
      <button
        class={`slider-dot w-3 h-3 rounded-full transition-all duration-300 cursor-pointer ${i === 0 ? 'bg-[#FF0000] w-8' : 'bg-white/40 hover:bg-white'}`}
        data-target-slide={i}
        aria-label={`Ir al slide ${i + 1}`}
      ></button>
    ))}
  </div>
</div>

<script>
  let currentSlide = 0;
  const slides = document.querySelectorAll('.hero-slide');
  const dots = document.querySelectorAll('.slider-dot');
  const totalSlides = slides.length;
  let autoplayTimer: any = null;

  function showSlide(index: number) {
    slides.forEach((slide, i) => {
      if (i === index) {
        slide.classList.remove('opacity-0', 'pointer-events-none', 'z-0');
        slide.classList.add('opacity-100', 'z-10');
      } else {
        slide.classList.remove('opacity-100', 'z-10');
        slide.classList.add('opacity-0', 'pointer-events-none', 'z-0');
      }
    });

    dots.forEach((dot, i) => {
      if (i === index) {
        dot.classList.add('bg-[#FF0000]', 'w-8');
        dot.classList.remove('bg-white/40');
      } else {
        dot.classList.remove('bg-[#FF0000]', 'w-8');
        dot.classList.add('bg-white/40');
      }
    });

    currentSlide = index;
  }

  function nextSlide() {
    const next = (currentSlide + 1) % totalSlides;
    showSlide(next);
  }

  function prevSlide() {
    const prev = (currentSlide - 1 + totalSlides) % totalSlides;
    showSlide(prev);
  }

  function startAutoplay() {
    stopAutoplay();
    autoplayTimer = setInterval(nextSlide, 6000);
  }

  function stopAutoplay() {
    if (autoplayTimer) clearInterval(autoplayTimer);
  }

  document.getElementById('slider-next')?.addEventListener('click', () => {
    nextSlide();
    startAutoplay();
  });

  document.getElementById('slider-prev')?.addEventListener('click', () => {
    prevSlide();
    startAutoplay();
  });

  dots.forEach((dot) => {
    dot.addEventListener('click', () => {
      const target = Number(dot.getAttribute('data-target-slide'));
      showSlide(target);
      startAutoplay();
    });
  });

  const slider = document.getElementById('hero-slider');
  slider?.addEventListener('mouseenter', stopAutoplay);
  slider?.addEventListener('mouseleave', startAutoplay);

  startAutoplay();
</script>

<style>
  #hero-slider {
    aspect-ratio: 1200 / 1800;
  }
  @media (min-width: 640px) {
    #hero-slider {
      aspect-ratio: 1884 / 835;
    }
  }
</style>
